function bluetooth_le_server_stop(): gmval;

[global, bind = typed_gml]
function bluetooth_le_server_is_running(): bool;

/// Adds a typed primary GATT service definition to the local peripheral/server.
/// OperationFailed while the server is not running; Busy for a service UUID already
