function bluetooth_le_characteristic_read(
    [type_hint=`uint64`] characteristic: gmval,
    callback: func
): gmval;

/// callback(error_code, message, characteristic). A write without response completes
/// when the platform has taken the bytes; it is InvalidArgument past the link's
/// maximum write length (Apple) and Busy while 64 of them wait to be sent.
