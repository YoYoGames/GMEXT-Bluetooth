    [type_hint=`func?`] on_stopped: gmval
): gmval;

[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_classic_server_stop(): gmval;

[global, bind = typed_gml]
function bluetooth_classic_server_is_running(): bool;

// =============================================================================
// Bluetooth Classic discoverability
// =============================================================================

/// Makes the local radio discoverable to other devices' Classic inquiry scans, so
/// bluetooth_classic_server_start's service can be found by an unpaired peer
/// (ClassicDiscoverable). Busy while discoverable. duration_seconds is clamped to
