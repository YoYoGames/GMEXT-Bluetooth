    callback: func
): gmval;

[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_server_clear_services(): gmval;

/// Answers a read request. error_code Success sends size bytes of data from offset;
/// any other code refuses the read, and data, offset and size are ignored.
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_server_respond_read(
    request_id: int32,
    [type_hint=`BluetoothAttError`] error_code: gmval,
    [type_hint=buffer] data: gmval,
    offset: uint32,
    size: uint32
): gmval;

/// Answers a write request. Call it for every write request, including one whose
/// response_needed was false: nothing is sent then, and the request is released.
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_server_respond_write(
    request_id: int32,
    [type_hint=`BluetoothAttError`] error_code: gmval
