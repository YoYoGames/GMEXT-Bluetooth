[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_characteristic_subscribe(
    [type_hint=`uint64`] characteristic: gmval,
    [type_hint=`BluetoothLeSubscribeMode`] mode: gmval,
    callback: func
): gmval;

/// callback(error_code, message, descriptor, value, size), as for
