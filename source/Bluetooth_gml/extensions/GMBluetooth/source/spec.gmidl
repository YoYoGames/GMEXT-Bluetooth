    [type_hint=`uint64`] connection: gmval
): bool;

[global, bind = typed_gml, type_hint=`uint64`]
function bluetooth_le_connection_get_device(
    [type_hint=`uint64`] connection: gmval
): gmval;

/// The ATT MTU of a connected client connection: a notification or a write without
/// response carries at most mtu - 3 bytes. 23 until a larger one is negotiated; 0
/// for a handle that is not a connected client connection.
[global, bind = typed_gml]
function bluetooth_le_connection_get_mtu(
