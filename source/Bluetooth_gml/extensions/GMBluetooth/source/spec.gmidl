[gml_api]
module GMBluetooth;

// Conventions
//
// Every call that can fail returns a BluetoothError, except those that return a handle:
// bluetooth_classic_connect and bluetooth_le_connect (so that bluetooth_*_disconnect can
// cancel a connect still in progress), bluetooth_device_from_id and the three *_find
// functions, which return 0 when they fail. After any failed return,
// bluetooth_last_error_code() and bluetooth_last_error_message() say why. A call that
// fails before it starts never fires its callback.
//
// A callback that reports an outcome that can fail leads with (error_code, message),
// followed by its data. An event that cannot fail carries data only, its subject first.
//
// Events belong to the call that starts their subject. A scan, a connection, a
// subscription, an advertisement and each server take their event callbacks as
// arguments and keep them until that subject ends; on_stopped or on_disconnected is the
// last event for it. The only global callback is bluetooth_set_callback_state_changed.
//
// The same condition fails with the same code on every platform:
//   a handle that is not (or no longer) valid       InvalidHandle
//   a device of the wrong transport, a bad argument InvalidArgument
//   the radio is off or resetting                   BluetoothDisabled
//   the permission is missing or was refused        PermissionDenied
//   no Bluetooth hardware, or a feature the platform
//   cannot do (see bluetooth_feature_is_supported)  NotSupported
//   the LE server is not running                    OperationFailed
//   a start while it already runs, a subscribe while
//   subscribed, a duplicate service, a full send or
//   notify queue                                    Busy
// These are checked before anything starts, so they come back from the call itself.
// A stop while idle is Ok and fires nothing.
//
// What the game ends fires no event: a stop or a disconnect the game asks for retires
// its subject in the call, and no on_stopped or on_disconnected fires for it, nor for
// the centrals bluetooth_le_server_stop retires or the advertising it ends.
//
// When the radio turns off (any state but PoweredOn or Unknown), everything running
// ends: each scan and the advertisement report on_stopped(BluetoothDisabled), each LE
// and Classic connection and each server central on_disconnected(BluetoothDisabled), a
// connect in progress fails with BluetoothDisabled, and each server reports on_stopped
// after its centrals, the LE server's services and attribute handles gone.
// Discoverability ends too, except on Android, which has no call to end it. Nothing
// restarts when the radio comes back.

// =============================================================================
// Constants
// =============================================================================

/// NotPermitted: the remote device refused the attribute operation (ATT read/write
/// not permitted, request not supported). InsufficientSecurity: it needs pairing,
/// encryption or authorization first (ATT insufficient authentication, authorization,
/// encryption or key size). The message names the ATT code.
[global, bind = typed_gml]
enum BluetoothError : int32 {
    Ok                   = 0,
    Unknown              = 1,
    NotSupported         = 2,
    NotInitialized       = 3,
    BluetoothDisabled    = 4,
    PermissionDenied     = 5,
    InvalidArgument      = 6,
    InvalidHandle        = 7,
    Busy                 = 8,
    Timeout              = 9,
    NotFound             = 10,
    ConnectionFailed     = 11,
    Disconnected         = 12,
    OperationFailed      = 13,
    NotPermitted         = 14,
    InsufficientSecurity = 15
}

/// ATT error codes (Bluetooth Core Specification, Vol 3, Part F, 3.4.1.1), used to
/// answer a GATT server read or write request.
[global, bind = typed_gml]
enum BluetoothAttError : int32 {
    Success                       = 0,
    InvalidHandle                 = 1,
    ReadNotPermitted              = 2,
    WriteNotPermitted             = 3,
    InvalidPdu                    = 4,
    InsufficientAuthentication    = 5,
    RequestNotSupported           = 6,
    InvalidOffset                 = 7,
    InsufficientAuthorization     = 8,
    PrepareQueueFull              = 9,
    AttributeNotFound             = 10,
    AttributeNotLong              = 11,
    InsufficientEncryptionKeySize = 12,
    InvalidAttributeValueLength   = 13,
    UnlikelyError                 = 14,
    InsufficientEncryption        = 15,
    UnsupportedGroupType          = 16,
    InsufficientResources         = 17
}

[global, bind = typed_gml]
enum BluetoothTransport : int32 {
    Unknown   = 0,
    Classic   = 1,
    LowEnergy = 2
}

[global, bind = typed_gml]
enum BluetoothPermissionStatus : int32 {
    Unknown = 0,
    Granted = 1,
    Denied  = 2
}

[global, bind = typed_gml]
enum BluetoothLeSubscribeMode : int32 {
    Notify   = 1,
    Indicate = 2
}

/// How hard an LE scan works, traded against power (LeScanMode). The members are
/// Android's ScanSettings modes; elsewhere the mode is ignored.
[global, bind = typed_gml]
enum BluetoothLeScanMode : int32 {
    LowPower   = 0,
    Balanced   = 1,
    LowLatency = 2
}

/// Cross-platform GATT characteristic-property bitmask, the GATT core properties
/// byte that Android, Apple and Windows share. Platform bits above 0x80 are masked
/// off what bluetooth_le_characteristic_get_properties() returns, and a server
/// characteristic definition that sets one is InvalidArgument.
[global, bind = typed_gml]
enum BluetoothLeCharacteristicProperty : int32 {
    None                      = 0,
    Broadcast                 = 1,
    Read                      = 2,
    WriteWithoutResponse      = 4,
    Write                     = 8,
    Notify                    = 16,
    Indicate                  = 32,
    AuthenticatedSignedWrites = 64,
    ExtendedProperties        = 128
}

/// GATT server attribute permission flags, combined with |. The values are Android's
/// BluetoothGattCharacteristic.PERMISSION_* bits. Apple and Windows have no signed
/// write permission: WriteSigned and WriteSignedMitm are NotSupported there.
[global, bind = typed_gml]
enum BluetoothLeAttributePermission : int32 {
    None               = 0,
    Read               = 1,
    ReadEncrypted      = 2,
    ReadEncryptedMitm  = 4,
    Write              = 16,
    WriteEncrypted     = 32,
    WriteEncryptedMitm = 64,
    WriteSigned        = 128,
    WriteSignedMitm    = 256
}

[global, bind = typed_gml]
enum BluetoothLeWriteType : int32 {
    WithResponse    = 0,
    WithoutResponse = 1
}

/// Advertising transmit power. The members are Android's AdvertiseSettings
/// levels; Windows maps them to -21, -15, -7 and 1 dBm.
[global, bind = typed_gml]
enum BluetoothLeAdvertiseTxPower : int32 {
    UltraLow = 0,
    Low      = 1,
    Medium   = 2,
    High     = 3
}

/// How fast a client LE connection runs, traded against power. The members are
/// Android's BluetoothGatt.CONNECTION_PRIORITY_* values; Windows 11 maps Balanced to
/// Balanced, High to ThroughputOptimized and LowPower to PowerOptimized.
[global, bind = typed_gml]
enum BluetoothLeConnectionPriority : int32 {
    Balanced = 0,
    High     = 1,
    LowPower = 2
}

/// Normalized local Bluetooth adapter/manager state.
[global, bind = typed_gml]
enum BluetoothState : int32 {
    Unknown      = 0,
    Resetting    = 1,
    Unsupported  = 2,
    Unauthorized = 3,
    PoweredOff   = 4,
    PoweredOn    = 5
}

/// What bluetooth_feature_is_supported() can be asked. LeCentral: LE scanning and
/// client connections. LeAdvertise and LeServer: the peripheral role. Classic and
/// ClassicServer: RFCOMM client and server. LePassiveScan: an LE scan with active
/// false really scans passively; elsewhere it is ignored. LeAdvertise*: the
/// advertisement can carry that part of BluetoothLeAdvertiseData or
/// BluetoothLeAdvertiseSettings; one that cannot is NotSupported from
/// bluetooth_le_advertise_start. LeServerDescriptorRequests: reads and writes of a
/// server descriptor with no static value reach on_read and on_write.
/// LeServerSignedWrite: the WriteSigned permissions. LeServerConnectionEvents: the
/// server's on_connected and on_disconnected report a central as it connects and
/// disconnects, not only around its requests and subscriptions. LePairing and
/// ClassicPairing: bluetooth_pair works for that transport. ClassicDiscoverableStop:
/// bluetooth_classic_discoverable_stop can end discoverability early.
/// PermissionRequest: bluetooth_permission_request shows a system prompt.
/// LeMtuRequest: bluetooth_le_connection_request_mtu negotiates the MTU asked for;
/// elsewhere the platform negotiates it itself and the request reports that value.
/// LeReadRssi: bluetooth_le_connection_read_rssi. LeConnectionPriority:
/// bluetooth_le_connection_request_priority. RequestEnable: bluetooth_request_enable
/// can turn the radio on. PairedDevicesQuery: bluetooth_paired_devices_query.
/// LeScanMode: BluetoothLeScanSettings.mode changes how the scan runs.
[global, bind = typed_gml]
enum BluetoothFeature : int32 {
    LeCentral                   = 0,
    LePassiveScan               = 1,
    LeAdvertise                 = 2,
    LeAdvertiseName             = 3,
    LeAdvertiseServiceUuids     = 4,
    LeAdvertiseServiceData      = 5,
    LeAdvertiseManufacturerData = 6,
    LeAdvertiseTxPower          = 7,
    LeAdvertiseIncludeTxPower   = 8,
    LeAdvertiseNonConnectable   = 9,
    LeServer                    = 10,
    LeServerDescriptorRequests  = 11,
    LeServerSignedWrite         = 12,
    LeServerConnectionEvents    = 13,
    LePairing                   = 14,
    Classic                     = 15,
    ClassicServer               = 16,
    ClassicPairing              = 17,
    ClassicDiscoverable         = 18,
    ClassicDiscoverableStop     = 19,
    PermissionRequest           = 20,
    LeMtuRequest                = 21,
    LeReadRssi                  = 22,
    LeConnectionPriority        = 23,
    RequestEnable               = 24,
    PairedDevicesQuery          = 25,
    LeScanMode                  = 26
}

// =============================================================================
// Connection options
// =============================================================================

/// How a connect runs. timeout_ms is the whole window from the call to an open link,
/// a pairing prompt included: 15000 when undefined, else 1000-300000. A connect still
/// not open when it ends fails with Timeout on every platform.
[global]
class `[[BluetoothConnectOptions]]` prototype Object {
    [field, type_hint=`int32?`]
    property timeout_ms : gmval { get; set; }
}

// =============================================================================
// BLE GATT server definitions
// =============================================================================

/// Descriptor definition used by BluetoothLeCharacteristicDefinition. value is a static
/// value of at most 512 bytes, served without reaching on_read; a User Description
/// (0x2901) value is UTF-8 text. The Client Characteristic Configuration descriptor
/// (0x2902) is managed by the platform and skipped. Apple can publish only a User
/// Description (0x2901) and a Presentation Format (0x2904), and only with a static
/// value; any other descriptor is NotSupported there (LeServerDescriptorRequests).
[global]
class `[[BluetoothLeDescriptorDefinition]]` prototype Object {
    [field]
    property uuid : string { get; set; }

    [field, type_hint=`uint8[]?`]
    property value : gmval { get; set; }
}

/// Characteristic definition used by BluetoothLeServiceDefinition.
/// properties is a combination of BluetoothLeCharacteristicProperty flags.
/// permissions is a combination of BluetoothLeAttributePermission flags.
/// value is the initial value, at most 512 bytes; undefined or empty means none.
/// descriptors undefined means none.
[global]
class `[[BluetoothLeCharacteristicDefinition]]` prototype Object {
    [field]
    property uuid : string { get; set; }

    [field]
    property properties : int32 { get; set; }

    [field]
    property permissions : int32 { get; set; }

    [field, type_hint=`uint8[]?`]
    property value : gmval { get; set; }

    [field, type_hint=`BluetoothLeDescriptorDefinition[]?`]
    property descriptors : gmval { get; set; }
}

/// Complete primary local GATT service definition. characteristics undefined means
/// none.
[global]
class `[[BluetoothLeServiceDefinition]]` prototype Object {
    [field]
    property uuid : string { get; set; }

    [field, type_hint=`BluetoothLeCharacteristicDefinition[]?`]
    property characteristics : gmval { get; set; }
}

// =============================================================================
// BLE advertising definitions
// =============================================================================

/// How the advertisement is sent. connectable undefined is true; tx_power undefined
/// is the platform default.
[global]
class `[[BluetoothLeAdvertiseSettings]]` prototype Object {
    [field, type_hint=`bool?`]
    property connectable : gmval { get; set; }

    [field, type_hint=`BluetoothLeAdvertiseTxPower?`]
    property tx_power : gmval { get; set; }
}

/// Service data for one service. Its uuid must also be in service_uuids.
[global]
class `[[BluetoothLeAdvertiseServiceData]]` prototype Object {
    [field]
    property uuid : string { get; set; }

    [field, type_hint=`uint8[]`]
    property data : gmval { get; set; }
}

/// Manufacturer-specific data under a Bluetooth SIG company identifier (0-65535).
[global]
class `[[BluetoothLeAdvertiseManufacturerData]]` prototype Object {
    [field]
    property company_id : int32 { get; set; }

    [field, type_hint=`uint8[]`]
    property data : gmval { get; set; }
}

/// What the advertisement carries. A field left undefined is off or empty.
/// include_name sends the system's device name; on iOS 16 and later that is the model
/// name ("iPhone", "iPad"), not the name the user gave the device.
[global]
class `[[BluetoothLeAdvertiseData]]` prototype Object {
    [field, type_hint=`bool?`]
    property include_name : gmval { get; set; }

    [field, type_hint=`bool?`]
    property include_tx_power : gmval { get; set; }

    [field, type_hint=`string[]?`]
    property service_uuids : gmval { get; set; }

    [field, type_hint=`BluetoothLeAdvertiseServiceData[]?`]
    property service_data : gmval { get; set; }

    [field, type_hint=`BluetoothLeAdvertiseManufacturerData[]?`]
    property manufacturer_data : gmval { get; set; }
}

// =============================================================================
// BLE scanning definitions
// =============================================================================

/// What a device has advertised, merged over every advertisement and scan response
/// since it entered the cache: service_uuids collects every UUID seen, a service
/// data or manufacturer data entry is the latest for its uuid or company_id, and
/// tx_power is the latest advertised TX Power Level in dBm, undefined when none
/// was advertised. UUIDs are lowercase 128-bit.
[global]
class `[[BluetoothLeAdvertisement]]` prototype Object {
    [field, type_hint=`string[]`]
    property service_uuids : gmval { get; set; }

    [field, type_hint=`BluetoothLeAdvertiseServiceData[]`]
    property service_data : gmval { get; set; }

    [field, type_hint=`BluetoothLeAdvertiseManufacturerData[]`]
    property manufacturer_data : gmval { get; set; }

    [field, type_hint=`int32?`]
    property tx_power : gmval { get; set; }
}

/// One scan filter. A device matches when every field that is set matches its merged
/// advertisement: service_uuid is among its advertised service UUIDs; name equals its
/// advertised local name and name_prefix starts it; company_id (0-65535) has
/// manufacturer data; service_data_uuid has service data. manufacturer_data needs
/// company_id and service_data needs service_data_uuid: the entry matches when its
/// first bytes equal data under mask, a mask of the same length (all bits when
/// undefined). A filter must set at least one field.
[global]
class `[[BluetoothLeScanFilter]]` prototype Object {
    [field, type_hint=`string?`]
    property service_uuid : gmval { get; set; }

    [field, type_hint=`string?`]
    property name : gmval { get; set; }

    [field, type_hint=`string?`]
    property name_prefix : gmval { get; set; }

    [field, type_hint=`int32?`]
    property company_id : gmval { get; set; }

    [field, type_hint=`uint8[]?`]
    property manufacturer_data : gmval { get; set; }

    [field, type_hint=`uint8[]?`]
    property manufacturer_data_mask : gmval { get; set; }

    [field, type_hint=`string?`]
    property service_data_uuid : gmval { get; set; }

    [field, type_hint=`uint8[]?`]
    property service_data : gmval { get; set; }

    [field, type_hint=`uint8[]?`]
    property service_data_mask : gmval { get; set; }
}

/// How an LE scan runs. active (true when undefined) requests scan-response packets;
/// false scans passively only where LePassiveScan is supported and is ignored
/// elsewhere. mode is a BluetoothLeScanMode, LowLatency when undefined (LeScanMode).
/// update_interval_ms is the least time between two on_updated calls for one device,
/// 1000 when undefined, 0-60000, 0 for every advertisement.
[global]
class `[[BluetoothLeScanSettings]]` prototype Object {
    [field, type_hint=`bool?`]
    property active : gmval { get; set; }

    [field, type_hint=`BluetoothLeScanMode?`]
    property mode : gmval { get; set; }

    [field, type_hint=`int32?`]
    property update_interval_ms : gmval { get; set; }
}

// =============================================================================
// BLE discovery definitions
// =============================================================================

/// How far bluetooth_le_services_discover goes before its callback. characteristics
/// also discovers the characteristics of each service, descriptors (which implies
/// characteristics) their descriptors too; service_uuids limits those deeper levels to
/// the services listed. Every service is listed either way.
[global]
class `[[BluetoothLeDiscoverOptions]]` prototype Object {
    [field, type_hint=`string[]?`]
    property service_uuids : gmval { get; set; }

    [field, type_hint=`bool?`]
    property characteristics : gmval { get; set; }

    [field, type_hint=`bool?`]
    property descriptors : gmval { get; set; }
}

// =============================================================================
// Lifecycle / event pump
// =============================================================================

/// True once the extension is loaded and running, also on a device with no
/// Bluetooth: that reports BluetoothState.Unsupported and false from
/// bluetooth_feature_is_supported, and every Bluetooth call is NotSupported.
[global, bind = typed_gml]
function bluetooth_initialize(): bool;

/// Ends every connection, scan, advertisement and server, fails each pending callback
/// once with NotInitialized and drops every event callback without firing it. The
/// state_changed callback stays registered for the next bluetooth_initialize.
[global, bind = typed_gml]
function bluetooth_shutdown(): unit;


[global, bind = typed_gml]
function bluetooth_is_initialized(): bool;

// =============================================================================
// Error state
// =============================================================================

[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_last_error_code(): gmval;

[global, bind = typed_gml]
function bluetooth_last_error_message(): string;

// =============================================================================
// Capabilities / permissions
// =============================================================================

/// Whether this platform and adapter can do feature, a BluetoothFeature; false for a
/// value that is not one. Ask after bluetooth_initialize: on Windows the answers
/// come from the adapter.
[global, bind = typed_gml]
function bluetooth_feature_is_supported([type_hint=`BluetoothFeature`] feature: gmval): bool;

/// Windows returns Granted. Android checks the runtime Bluetooth/location
/// permission set required by the current Android version. Apple reports the
/// app's Bluetooth authorization: Unknown until bluetooth_permission_request has
/// been answered, Denied when refused or restricted.
[global, bind = typed_gml, type_hint=`BluetoothPermissionStatus`]
function bluetooth_permission_get_status(): gmval;

/// Asks for the Bluetooth permissions the platform needs, showing the system prompt
/// when the answer is not known yet. callback(error_code, message, status), status a
/// BluetoothPermissionStatus, fires once: when the user answers, or at once when the
/// answer is already known (always Granted on Windows). Its error_code is Ok whenever
/// the request was answered, also when refused (status says which), and
/// NotInitialized when bluetooth_shutdown comes first. Returns NotInitialized before
/// bluetooth_initialize; on Android, OperationFailed when the prompt cannot be shown
/// (no activity, or requestPermissions threw). The callback is not called unless the
/// return is Ok. On Apple the prompt appears only here; until it has been answered,
/// every call that uses Bluetooth returns PermissionDenied, as on Android without the
/// runtime permissions.
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_permission_request(callback: func): gmval;

/// Asks the user to turn the Bluetooth radio on (RequestEnable). callback(error_code,
/// message) fires once: Ok when the radio is on, at once when it already was;
/// BluetoothDisabled when the user declined or the radio stayed off; PermissionDenied
/// when the system refused the request; on Windows, OperationFailed when the request
/// failed; NotInitialized when bluetooth_shutdown comes first. Returns NotInitialized
/// before bluetooth_initialize, NotSupported when RequestEnable is not supported, and
/// otherwise Ok or a pre-flight failure that fires no callback. Android shows the
/// system dialog and needs the Bluetooth permission on Android 12+ (PermissionDenied
/// before it starts), and returns OperationFailed when the dialog cannot be shown.
/// Windows asks for radio access and switches the radio on; it returns NotSupported
/// with no radio, and OperationFailed when its worker thread is not running. Apple has
/// no API to do this: NotSupported.
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_request_enable(callback: func): gmval;

// =============================================================================
// BLE discovery
// =============================================================================

/// Starts an LE scan. settings is a BluetoothLeScanSettings, filters an array of
/// BluetoothLeScanFilter; either may be undefined. With no filters every device is
/// reported, otherwise a device is reported once its advertisement, merged over every
/// packet the device sent, matches any one of them. A bad setting or filter (no field
/// set, a malformed UUID, a company_id outside 0-65535, data without its key, a mask
/// of another length, a mode that is not a BluetoothLeScanMode) is InvalidArgument;
/// Android reads such a mode as undefined. Busy while a scan runs: stop it first to
/// change it.
/// on_found(device) fires the first time this scan sees a device, also one an earlier
/// scan put in the cache. on_updated(device) fires for the device's later
/// advertisements in this scan, at most once per update_interval_ms per device; the
/// getters return what it advertised. on_stopped(error_code, message) fires when the scan ends without
/// bluetooth_le_scan_stop. Fails before it starts with BluetoothDisabled,
/// PermissionDenied or NotSupported; while the state is still Unknown the scan starts
/// once the radio is ready. Android filters in the Bluetooth stack, allows 5 scan
/// starts per 30 seconds - a sixth starts but finds nothing - and pauses unfiltered
/// scans while the screen is off; with the manifest's neverForLocation flag it also
/// leaves out some beacon advertisements. iOS needs every filter to set service_uuid
/// to scan in the background, and never reports iBeacon advertisements.
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_scan_start(
    [type_hint=`BluetoothLeScanSettings?`] settings: gmval,
    [type_hint=`BluetoothLeScanFilter[]?`] filters: gmval,
    on_found: func,
    [type_hint=`func?`] on_updated: gmval,
    [type_hint=`func?`] on_stopped: gmval
): gmval;

[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_scan_stop(): gmval;

[global, bind = typed_gml]
function bluetooth_le_scan_is_running(): bool;

// =============================================================================
// Bluetooth Classic discovery
// =============================================================================

/// Starts a Classic inquiry. Busy while one runs. on_found(device) fires the first time
/// this inquiry sees a device, on_updated(device) when the device answers again or its
/// name is resolved, and on_stopped(error_code, message) when the inquiry ends without
/// bluetooth_classic_scan_stop: Ok with an empty message when it ran its course. Windows inquires for about 5 seconds and reports every device at the end;
/// Android and macOS report devices as they answer.
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_classic_scan_start(
    on_found: func,
    [type_hint=`func?`] on_updated: gmval,
    [type_hint=`func?`] on_stopped: gmval
): gmval;

[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_classic_scan_stop(): gmval;

[global, bind = typed_gml]
function bluetooth_classic_scan_is_running(): bool;

// =============================================================================
// Shared discovered-device cache
// =============================================================================

/// Empties the device cache; every device handle becomes invalid. The cache keeps
/// every device seen since the last clear (handles are never reused), so call this
/// during long scans in busy places. A device a running scan sees again comes back
/// under a new handle, through on_found.
[global, bind = typed_gml]
function bluetooth_device_clear(): unit;

[global, bind = typed_gml]
function bluetooth_device_get_count(): int32;

[global, bind = typed_gml, type_hint=`uint64`]
function bluetooth_device_get_at(index: int32): gmval;

/// The device getters answer a handle that is not valid with an empty string, 0,
/// false, undefined or an empty advertisement.
[global, bind = typed_gml]
function bluetooth_device_is_valid([type_hint=`uint64`] device: gmval): bool;

[global, bind = typed_gml, type_hint=`BluetoothTransport`]
function bluetooth_device_get_transport([type_hint=`uint64`] device: gmval): gmval;

/// The device's id, the same on every platform that can address it:
/// "classic:AA:BB:CC:DD:EE:FF" for a Classic device; "le:public:..." or
/// "le:random:..." for an LE device whose address type is known, "le:..." when it is
/// not (Android before 15); "le:apple:" and the peripheral's identifier on Apple,
/// which never exposes an LE address. Empty for a device with no address.
[global, bind = typed_gml]
function bluetooth_device_get_id([type_hint=`uint64`] device: gmval): string;

[global, bind = typed_gml]
function bluetooth_device_get_name([type_hint=`uint64`] device: gmval): string;

/// The device's address as "AA:BB:CC:DD:EE:FF", undefined when the platform does not
/// expose it (every LE device on Apple).
[global, bind = typed_gml, type_hint=`string?`]
function bluetooth_device_get_address([type_hint=`uint64`] device: gmval): gmval;

/// The latest signal strength in dBm, undefined when none was seen.
[global, bind = typed_gml, type_hint=`int32?`]
function bluetooth_device_get_rssi([type_hint=`uint64`] device: gmval): gmval;

/// Milliseconds since a scan last saw the device, undefined when no scan has (a device
/// from bluetooth_device_from_id, a query or an inbound link).
[global, bind = typed_gml, type_hint=`int32?`]
function bluetooth_device_get_last_seen_age([type_hint=`uint64`] device: gmval): gmval;

[global, bind = typed_gml]
function bluetooth_device_is_connectable([type_hint=`uint64`] device: gmval): bool;

/// What the device has advertised (see BluetoothLeAdvertisement). Every field is
/// empty for a Classic device, one never seen advertising, or an invalid handle.
[global, bind = typed_gml, type_hint=`BluetoothLeAdvertisement`]
function bluetooth_device_get_advertisement([type_hint=`uint64`] device: gmval): gmval;

/// Returns the handle of the device an id from bluetooth_device_get_id names, so a
/// remembered device can be connected without scanning. A device already in the cache
/// keeps its handle; otherwise it enters the cache without firing any scan callback,
/// and its name is empty until the platform knows it. 0 when it cannot, the reason in
/// bluetooth_last_error_code(): NotInitialized before bluetooth_initialize;
/// InvalidArgument for a malformed id or one this platform cannot address (an
/// "le:apple:" id off Apple, an LE address on Apple); on Apple, PermissionDenied until
