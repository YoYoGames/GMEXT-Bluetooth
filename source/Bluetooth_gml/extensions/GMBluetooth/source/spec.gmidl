// =============================================================================
// Bluetooth Classic RFCOMM client
// =============================================================================

/// Starts an asynchronous RFCOMM connection. options is a BluetoothConnectOptions or
/// undefined. Returns a connection handle immediately, or 0 if the request cannot
/// start, the reason then in bluetooth_last_error_code(). callback(error_code, message,
/// connection, device) fires once: Ok when the link is open, Timeout when it is not
/// open within options.timeout_ms, ConnectionFailed when it was refused, failed or was
/// cancelled by bluetooth_classic_disconnect. The link is authenticated and encrypted
/// (secure RFCOMM), so an unpaired peer may see a pairing prompt, which counts toward
/// the timeout.
/// on_data(connection, value, size) fires for every chunk of bytes the connection
/// receives, in order. value is a value handle holding size bytes; fetch them with
/// bluetooth_value_fetch(). While the connection's unfetched values hold more than
/// 1 MiB, Windows and Android stop reading from the peer until some are fetched or
/// released; macOS cannot pause a channel, so it ends the connection with Disconnected
/// ("receive buffer full"). A value left unfetched for 30 seconds ends its connection
/// with Disconnected ("receive data expired") rather than leave a gap in the stream.
/// on_disconnected(error_code, message, connection) fires when the open link ends
/// without bluetooth_classic_disconnect: the peer closed it or the link failed
/// (Disconnected, or the error that ended it), after its last on_data.
[global, bind = typed_gml, type_hint=`uint64`]
function bluetooth_classic_connect(
    [type_hint=`uint64`] device: gmval,
    service_uuid: string,
    [type_hint=`BluetoothConnectOptions?`] options: gmval,
    on_data: func,
    on_disconnected: func,
    callback: func
): gmval;

[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_classic_disconnect(
    [type_hint=`uint64`] connection: gmval
): gmval;

[global, bind = typed_gml]
function bluetooth_classic_connection_is_valid(
    [type_hint=`uint64`] connection: gmval
): bool;

[global, bind = typed_gml]
function bluetooth_classic_connection_is_connected(
    [type_hint=`uint64`] connection: gmval
): bool;

[global, bind = typed_gml, type_hint=`uint64`]
function bluetooth_classic_connection_get_device(
    [type_hint=`uint64`] connection: gmval
): gmval;

/// Queues bytes from a GameMaker buffer to be sent over the RFCOMM connection and
/// returns without waiting for them to go out. Busy when the bytes would take the
/// connection's queue past 1 MiB, so send more than that in parts.
/// A send that later fails ends the connection through its on_disconnected.
