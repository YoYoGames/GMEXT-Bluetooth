[gml_api]
module GMBluetooth;

// Conventions
//
// Every call that can fail returns a BluetoothError, except bluetooth_classic_connect
// and bluetooth_le_connect, which return the new connection handle so that
// bluetooth_*_disconnect can cancel a connect still in progress; they return 0 when
// the connect did not start. After any failed return, bluetooth_last_error_code()
// and bluetooth_last_error_message() say why. A call that fails before it starts
// never fires its callback.
//
// A callback that reports an outcome that can fail leads with (error_code, message),
// followed by its data. An event that cannot fail carries data only, its subject first.

// =============================================================================
// Constants
// =============================================================================

/// NotPermitted: the remote device refused the attribute operation (ATT read/write
/// not permitted, request not supported). InsufficientSecurity: it needs pairing,
/// encryption or authorization first (ATT insufficient authentication, authorization,
/// encryption or key size). The message names the ATT code.
[global, bind = typed_gml]
enum BluetoothError : int32 {
    Ok                   = 0,
    Unknown              = 1,
    NotSupported         = 2,
    NotInitialized       = 3,
    BluetoothDisabled    = 4,
    PermissionDenied     = 5,
    InvalidArgument      = 6,
    InvalidHandle        = 7,
    Busy                 = 8,
    Timeout              = 9,
    NotFound             = 10,
    ConnectionFailed     = 11,
    Disconnected         = 12,
    OperationFailed      = 13,
    NotPermitted         = 14,
    InsufficientSecurity = 15
}

/// ATT error codes (Bluetooth Core Specification, Vol 3, Part F, 3.4.1.1), used to
/// answer a GATT server read or write request.
[global, bind = typed_gml]
enum BluetoothAttError : int32 {
    Success                       = 0,
    InvalidHandle                 = 1,
    ReadNotPermitted              = 2,
    WriteNotPermitted             = 3,
    InvalidPdu                    = 4,
    InsufficientAuthentication    = 5,
    RequestNotSupported           = 6,
    InvalidOffset                 = 7,
    InsufficientAuthorization     = 8,
    PrepareQueueFull              = 9,
    AttributeNotFound             = 10,
    AttributeNotLong              = 11,
    InsufficientEncryptionKeySize = 12,
    InvalidAttributeValueLength   = 13,
    UnlikelyError                 = 14,
    InsufficientEncryption        = 15,
    UnsupportedGroupType          = 16,
    InsufficientResources         = 17
}

[global, bind = typed_gml]
enum BluetoothTransport : int32 {
    Unknown   = 0,
    Classic   = 1,
    LowEnergy = 2
}

[global, bind = typed_gml]
enum BluetoothPermissionStatus : int32 {
    Unknown = 0,
    Granted = 1,
    Denied  = 2
}

[global, bind = typed_gml]
enum BluetoothLeSubscribeMode : int32 {
    Unsubscribe = 0,
    Notify      = 1,
    Indicate    = 2
}

/// Cross-platform GATT characteristic-property bitmask. Raw numeric values are
/// used intentionally. Values through ExtendedProperties are shared by Android
/// BluetoothGattCharacteristic, Apple CoreBluetooth, and Windows GATT.
[global, bind = typed_gml]
enum BluetoothLeCharacteristicProperty : int32 {
    None                      = 0,
    Broadcast                 = 1,
    Read                      = 2,
    WriteWithoutResponse      = 4,
    Write                     = 8,
    Notify                    = 16,
    Indicate                  = 32,
    AuthenticatedSignedWrites = 64,
    ExtendedProperties        = 128
}

/// GATT server attribute permission flags, combined with |. The values are Android's
/// BluetoothGattCharacteristic.PERMISSION_* bits. Apple and Windows have no signed
/// write permission: WriteSigned and WriteSignedMitm are NotSupported there.
[global, bind = typed_gml]
enum BluetoothLeAttributePermission : int32 {
    None               = 0,
    Read               = 1,
    ReadEncrypted      = 2,
    ReadEncryptedMitm  = 4,
    Write              = 16,
    WriteEncrypted     = 32,
    WriteEncryptedMitm = 64,
    WriteSigned        = 128,
    WriteSignedMitm    = 256
}

[global, bind = typed_gml]
enum BluetoothLeWriteType : int32 {
    WithResponse    = 0,
    WithoutResponse = 1
}

/// Advertising transmit power. The members are Android's AdvertiseSettings
/// levels; Windows maps them to -21, -15, -7 and 1 dBm.
[global, bind = typed_gml]
enum BluetoothLeAdvertiseTxPower : int32 {
    UltraLow = 0,
    Low      = 1,
    Medium   = 2,
    High     = 3
}

/// Normalized local Bluetooth adapter/manager state.
[global, bind = typed_gml]
enum BluetoothState : int32 {
    Unknown      = 0,
    Resetting    = 1,
    Unsupported  = 2,
    Unauthorized = 3,
    PoweredOff   = 4,
    PoweredOn    = 5
}

// =============================================================================
// BLE GATT server definitions
// =============================================================================

/// Descriptor definition used by BluetoothLeCharacteristicDefinition.
[global]
class `[[BluetoothLeDescriptorDefinition]]` prototype Object {
    [field]
    property uuid : string { get; set; }
}

/// Characteristic definition used by BluetoothLeServiceDefinition.
/// properties is a combination of BluetoothLeCharacteristicProperty flags.
/// permissions is a combination of BluetoothLeAttributePermission flags.
/// value is the initial value, at most 512 bytes; an empty array means none.
[global]
class `[[BluetoothLeCharacteristicDefinition]]` prototype Object {
    [field]
    property uuid : string { get; set; }

    [field]
    property properties : int32 { get; set; }

    [field]
    property permissions : int32 { get; set; }

    [field, type_hint=`uint8[]`]
    property value : gmval { get; set; }

    [field, type_hint=`BluetoothLeDescriptorDefinition[]`]
    property descriptors : gmval { get; set; }
}

/// Complete primary local GATT service definition.
[global]
class `[[BluetoothLeServiceDefinition]]` prototype Object {
    [field]
    property uuid : string { get; set; }

    [field, type_hint=`BluetoothLeCharacteristicDefinition[]`]
    property characteristics : gmval { get; set; }
}

// =============================================================================
// BLE advertising definitions
// =============================================================================

/// How the advertisement is sent. tx_power left undefined is the platform default.
[global]
class `[[BluetoothLeAdvertiseSettings]]` prototype Object {
    [field]
    property connectable : bool { get; set; }

    [field, type_hint=`BluetoothLeAdvertiseTxPower?`]
    property tx_power : gmval { get; set; }
}

/// Service data for one service. Its uuid must also be in service_uuids.
[global]
class `[[BluetoothLeAdvertiseServiceData]]` prototype Object {
    [field]
    property uuid : string { get; set; }

    [field, type_hint=`uint8[]`]
    property data : gmval { get; set; }
}

/// Manufacturer-specific data under a Bluetooth SIG company identifier (0-65535).
[global]
class `[[BluetoothLeAdvertiseManufacturerData]]` prototype Object {
    [field]
    property company_id : int32 { get; set; }

    [field, type_hint=`uint8[]`]
    property data : gmval { get; set; }
}

/// What the advertisement carries.
[global]
class `[[BluetoothLeAdvertiseData]]` prototype Object {
    [field]
    property include_name : bool { get; set; }

    [field]
    property include_tx_power : bool { get; set; }

    [field, type_hint=`string[]`]
    property service_uuids : gmval { get; set; }

    [field, type_hint=`BluetoothLeAdvertiseServiceData[]`]
    property service_data : gmval { get; set; }

    [field, type_hint=`BluetoothLeAdvertiseManufacturerData[]`]
    property manufacturer_data : gmval { get; set; }
}

// =============================================================================
// Lifecycle / event pump
// =============================================================================

[global, bind = typed_gml]
function bluetooth_initialize(): bool;

[global, bind = typed_gml]
function bluetooth_shutdown(): unit;


[global, bind = typed_gml]
function bluetooth_is_initialized(): bool;

// =============================================================================
// Error state
// =============================================================================

[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_last_error_code(): gmval;

[global, bind = typed_gml]
function bluetooth_last_error_message(): string;

// =============================================================================
// Capabilities / permissions
// =============================================================================

[global, bind = typed_gml]
function bluetooth_le_is_supported(): bool;

[global, bind = typed_gml]
function bluetooth_le_advertise_is_supported(): bool;

[global, bind = typed_gml]
function bluetooth_le_server_is_supported(): bool;

[global, bind = typed_gml]
function bluetooth_classic_is_supported(): bool;

[global, bind = typed_gml]
function bluetooth_classic_server_is_supported(): bool;

/// Windows returns Granted. Android checks the runtime Bluetooth/location
/// permission set required by the current Android version.
[global, bind = typed_gml, type_hint=`BluetoothPermissionStatus`]
function bluetooth_permission_get_status(): gmval;

/// Asks for the Bluetooth permissions the platform needs, showing the system prompt
/// when the answer is not known yet. callback(error_code, message, status), status a
/// BluetoothPermissionStatus, fires once: when the user answers, or at once when the
/// answer is already known (always Granted on Windows). On Apple the prompt appears
/// only here; until it has been answered, every call that uses Bluetooth returns
/// PermissionDenied, as on Android without the runtime permissions.
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_permission_request(callback: func): gmval;

// =============================================================================
// BLE discovery
// =============================================================================

/// active=true requests scan-response packets where the platform supports it.
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_scan_start(active: bool): gmval;

[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_scan_stop(): gmval;

[global, bind = typed_gml]
function bluetooth_le_scan_is_running(): bool;

// =============================================================================
// Bluetooth Classic discovery
// =============================================================================

[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_classic_scan_start(): gmval;

[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_classic_scan_stop(): gmval;

[global, bind = typed_gml]
function bluetooth_classic_scan_is_running(): bool;

// =============================================================================
// Shared discovered-device cache
// =============================================================================

[global, bind = typed_gml]
function bluetooth_device_clear(): unit;

[global, bind = typed_gml]
function bluetooth_device_get_count(): int32;

[global, bind = typed_gml, type_hint=`uint64`]
function bluetooth_device_get_at(index: int32): gmval;

[global, bind = typed_gml]
function bluetooth_device_is_valid([type_hint=`uint64`] device: gmval): bool;

[global, bind = typed_gml, type_hint=`BluetoothTransport`]
function bluetooth_device_get_transport([type_hint=`uint64`] device: gmval): gmval;

/// Opaque platform identifier. Do not assume this is a MAC address.
[global, bind = typed_gml]
function bluetooth_device_get_id([type_hint=`uint64`] device: gmval): string;

[global, bind = typed_gml]
function bluetooth_device_get_name([type_hint=`uint64`] device: gmval): string;

[global, bind = typed_gml]
function bluetooth_device_has_address([type_hint=`uint64`] device: gmval): bool;

[global, bind = typed_gml]
function bluetooth_device_get_address([type_hint=`uint64`] device: gmval): string;

[global, bind = typed_gml]
function bluetooth_device_has_rssi([type_hint=`uint64`] device: gmval): bool;

[global, bind = typed_gml]
function bluetooth_device_get_rssi([type_hint=`uint64`] device: gmval): int32;

[global, bind = typed_gml]
function bluetooth_device_is_connectable([type_hint=`uint64`] device: gmval): bool;

// =============================================================================
// Bluetooth Classic RFCOMM client
// =============================================================================

/// Starts an asynchronous RFCOMM connection.
/// Returns a connection handle immediately, or 0 if the request cannot start, the
/// reason then in bluetooth_last_error_code(). bluetooth_classic_disconnect on the
/// handle cancels a connect still in progress. A connect that has not completed
/// after 15 seconds fails with Timeout on Windows.
/// callback(error_code, message, connection, device)
[global, bind = typed_gml, type_hint=`uint64`]
function bluetooth_classic_connect(
    [type_hint=`uint64`] device: gmval,
    service_uuid: string,
    callback: func
): gmval;

[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_classic_disconnect(
    [type_hint=`uint64`] connection: gmval
): gmval;

[global, bind = typed_gml]
function bluetooth_classic_connection_is_valid(
    [type_hint=`uint64`] connection: gmval
): bool;

[global, bind = typed_gml]
function bluetooth_classic_connection_is_connected(
    [type_hint=`uint64`] connection: gmval
): bool;

[global, bind = typed_gml, type_hint=`uint64`]
function bluetooth_classic_connection_get_device(
    [type_hint=`uint64`] connection: gmval
): gmval;

/// Number of native bytes waiting to be copied into GML.
[global, bind = typed_gml]
function bluetooth_classic_receive_available(
    [type_hint=`uint64`] connection: gmval
): int32;

/// Queues bytes from a GameMaker buffer to be sent over the RFCOMM connection and
/// returns without waiting for them to go out. Busy when the bytes would take the
/// connection's queue past 1 MiB, so send more than that in parts.
/// A send that later fails ends the connection through the classic_disconnected
/// callback.
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_classic_send(
    [type_hint=`uint64`] connection: gmval,
    [type_hint=buffer] data: gmval,
    offset: uint32,
    size: uint32
): gmval;

/// Copies available RFCOMM bytes into a GameMaker buffer.
[global, bind = typed_gml]
function bluetooth_classic_receive(
    [type_hint=`uint64`] connection: gmval,
    [type_hint=buffer] out_data: gmval,
    offset: uint32,
    max_size: uint32
): int32;

// =============================================================================
// Bluetooth Classic RFCOMM server
// =============================================================================

/// Starts an RFCOMM service using the supplied UUID. Busy while a server is already
/// running: stop it first to change its name or UUID.
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_classic_server_start(
    name: string,
    service_uuid: string
): gmval;

[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_classic_server_stop(): gmval;

[global, bind = typed_gml]
function bluetooth_classic_server_is_running(): bool;

// =============================================================================
// Bluetooth Classic discoverability
// =============================================================================

/// Makes the local radio discoverable to other devices' Classic inquiry scans, so
/// bluetooth_classic_server_start's service can actually be found by an unpaired peer.
/// duration_seconds: how long to stay discoverable. 0 = indefinite where the platform allows it.
/// Windows: fully supported, start/stop both work, duration enforced by this extension via a timer.
/// Android: requests discoverability from the OS for duration_seconds (0 is treated as the
///   Android default of 120s, since Android does not support a real "indefinite" here); there is
///   no OS API to cancel discoverability early, so bluetooth_classic_discoverable_stop returns
///   NotSupported on this platform and it simply expires on its own.
/// macOS/iOS: no public API exists; returns NotSupported.
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_classic_discoverable_start(duration_seconds: int32): gmval;

/// Stops discoverability early. See bluetooth_classic_discoverable_start for per-platform support
/// (NotSupported on Android and Apple).
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_classic_discoverable_stop(): gmval;

[global, bind = typed_gml]
function bluetooth_classic_discoverable_is_running(): bool;

// =====================================================================
// Bluetooth pairing (bonding)
// =====================================================================

/// Whether this extension can explicitly initiate OS-level pairing for the
/// supplied device. This is device/transport-specific rather than a single
/// platform capability. Apple BLE pairing is implicit and therefore reports false.
[global, bind = typed_gml]
function bluetooth_pairing_is_supported([type_hint=`uint64`] device: gmval): bool;

/// Attempts to pair (bond) with the given device at the OS level. This is separate from
/// bluetooth_classic_connect/bluetooth_le_connect: some connections only succeed once the
/// two devices are paired, and once paired the OS remembers the relationship across app runs.
/// Returns immediately with an error code indicating whether the pairing request was
/// accepted; callback is invoked once, later, when pairing actually completes or fails:
/// callback(error_code, message, device).
/// Android: works uniformly for Classic and LE devices, via BluetoothDevice.createBond().
/// Windows: Classic only, via BluetoothAuthenticateDeviceEx. Returns NotSupported for LE
///   devices.
/// macOS: Classic only, via IOBluetoothDevicePair. Returns NotSupported for LE devices -
///   BLE bonding on Apple platforms happens implicitly when a protected characteristic is
///   accessed and cannot be triggered explicitly.
/// iOS: always NotSupported (Classic isn't supported on iOS; BLE bonding is implicit, as above).
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_pair([type_hint=`uint64`] device: gmval, callback: func): gmval;

/// Whether the given device is currently paired/bonded at the OS level.
/// Android: BluetoothDevice.getBondState() == BOND_BONDED. Works for Classic and LE.
/// Windows: BluetoothGetDeviceInfo's fAuthenticated flag. Classic only; always false for LE.
/// macOS: IOBluetoothDevice.isPaired. Classic only; always false for LE, since Apple exposes
///   no public bond-state query for CoreBluetooth peripherals.
/// iOS: always false.
[global, bind = typed_gml]
function bluetooth_device_is_paired([type_hint=`uint64`] device: gmval): bool;

// =============================================================================
// BLE GATT client: connect / disconnect
// =============================================================================

/// Starts an asynchronous GATT connection to a previously discovered LE device.
/// Returns a connection handle immediately, or 0 if the request cannot start, the
/// reason then in bluetooth_last_error_code(). bluetooth_le_disconnect on the handle
/// cancels a connect still in progress.
/// callback(error_code, message, connection, device)
[global, bind = typed_gml, type_hint=`uint64`]
function bluetooth_le_connect(
    [type_hint=`uint64`] device: gmval,
    callback: func
): gmval;

[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_disconnect(
    [type_hint=`uint64`] connection: gmval
): gmval;

[global, bind = typed_gml]
function bluetooth_le_connection_is_valid(
    [type_hint=`uint64`] connection: gmval
): bool;

[global, bind = typed_gml]
function bluetooth_le_connection_is_connected(
    [type_hint=`uint64`] connection: gmval
): bool;

[global, bind = typed_gml, type_hint=`uint64`]
function bluetooth_le_connection_get_device(
    [type_hint=`uint64`] connection: gmval
): gmval;

// =============================================================================
// BLE GATT client: service / characteristic / descriptor discovery
// =============================================================================

/// Starts asynchronous service discovery for a connected LE device.
/// callback(error_code, message, connection)
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_services_discover(
    [type_hint=`uint64`] connection: gmval,
    callback: func
): gmval;

[global, bind = typed_gml]
function bluetooth_le_service_get_count(
    [type_hint=`uint64`] connection: gmval
): int32;

[global, bind = typed_gml, type_hint=`uint64`]
function bluetooth_le_service_get_at(
    [type_hint=`uint64`] connection: gmval,
    index: int32
): gmval;

[global, bind = typed_gml]
function bluetooth_le_service_get_uuid(
    [type_hint=`uint64`] service: gmval
): string;

/// Starts asynchronous characteristic discovery for a discovered service.
/// callback(error_code, message, service)
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_characteristics_discover(
    [type_hint=`uint64`] service: gmval,
    callback: func
): gmval;

[global, bind = typed_gml]
function bluetooth_le_characteristic_get_count(
    [type_hint=`uint64`] service: gmval
): int32;

[global, bind = typed_gml, type_hint=`uint64`]
function bluetooth_le_characteristic_get_at(
    [type_hint=`uint64`] service: gmval,
    index: int32
): gmval;

[global, bind = typed_gml]
function bluetooth_le_characteristic_get_uuid(
    [type_hint=`uint64`] characteristic: gmval
): string;

/// Returns a BluetoothLeCharacteristicProperty bitmask.
[global, bind = typed_gml]
function bluetooth_le_characteristic_get_properties(
    [type_hint=`uint64`] characteristic: gmval
): int32;

/// Starts asynchronous descriptor discovery for a discovered characteristic.
/// callback(error_code, message, characteristic)
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_descriptors_discover(
    [type_hint=`uint64`] characteristic: gmval,
    callback: func
): gmval;

[global, bind = typed_gml]
function bluetooth_le_descriptor_get_count(
    [type_hint=`uint64`] characteristic: gmval
): int32;

[global, bind = typed_gml, type_hint=`uint64`]
function bluetooth_le_descriptor_get_at(
    [type_hint=`uint64`] characteristic: gmval,
    index: int32
): gmval;

[global, bind = typed_gml]
function bluetooth_le_descriptor_get_uuid(
    [type_hint=`uint64`] descriptor: gmval
): string;

// =============================================================================
// BLE GATT client: characteristic / descriptor read, write, subscribe
// =============================================================================

/// Starts an asynchronous characteristic read.
/// callback(error_code, message, characteristic, value, size). value is a value
/// handle holding the bytes read (0, with size 0, on failure); copy them with
/// bluetooth_le_value_copy().
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_characteristic_read(
    [type_hint=`uint64`] characteristic: gmval,
    callback: func
): gmval;

/// callback(error_code, message, characteristic)
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_characteristic_write(
    [type_hint=`uint64`] characteristic: gmval,
    [type_hint=buffer] data: gmval,
    offset: uint32,
    size: uint32,
    [type_hint=`BluetoothLeWriteType`] write_type: gmval,
    callback: func
): gmval;

/// callback(error_code, message, characteristic)
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_characteristic_subscribe(
    [type_hint=`uint64`] characteristic: gmval,
    [type_hint=`BluetoothLeSubscribeMode`] mode: gmval,
    callback: func
): gmval;

/// callback(error_code, message, descriptor, value, size), as for
/// bluetooth_le_characteristic_read().
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_descriptor_read(
    [type_hint=`uint64`] descriptor: gmval,
    callback: func
): gmval;

[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_descriptor_write(
    [type_hint=`uint64`] descriptor: gmval,
    [type_hint=buffer] data: gmval,
    offset: uint32,
    size: uint32,
    callback: func
): gmval;

// =============================================================================
// BLE values
// =============================================================================

/// Copies a value delivered by a read or a notification callback into out_data at
/// offset - all size bytes the callback reported - and frees the value. A buffer
/// too small for it is InvalidArgument and keeps the value. At most 256 values are
/// held; past that the oldest is dropped, and shutdown frees them all.
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_value_copy(
    [type_hint=`uint64`] value: gmval,
    [type_hint=buffer] out_data: gmval,
    offset: uint32
): gmval;

/// Frees a value without copying it.
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_value_release(
    [type_hint=`uint64`] value: gmval
): gmval;

// =============================================================================
// BLE advertise
// =============================================================================

/// Starts advertising. A field the platform cannot send is NotSupported before
/// anything starts: Apple sends only the name and the service UUIDs and is always
/// connectable; Windows sends a service UUID, its service data and the name only
/// through a registered GATT service.
/// callback(error_code, message)
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_advertise_start(
    [type_hint=`BluetoothLeAdvertiseSettings`] settings: gmval,
    [type_hint=`BluetoothLeAdvertiseData`] data: gmval,
    callback: func
): gmval;

[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_advertise_stop(): gmval;

[global, bind = typed_gml]
function bluetooth_le_advertise_is_running(): bool;

// =============================================================================
// BLE GATT server (peripheral)
// =============================================================================

[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_server_start(): gmval;

[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_server_stop(): gmval;

[global, bind = typed_gml]
function bluetooth_le_server_is_running(): bool;

/// Adds a typed primary GATT service definition to the local peripheral/server.
/// callback(error_code, message)
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_server_add_service(
    [type_hint=`BluetoothLeServiceDefinition`] service: gmval,
    callback: func
): gmval;

[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_server_clear_services(): gmval;

/// Answers a read request. error_code Success sends size bytes of data from offset;
/// any other code refuses the read, and data, offset and size are ignored.
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_server_respond_read(
    request_id: int32,
    [type_hint=`BluetoothAttError`] error_code: gmval,
    [type_hint=buffer] data: gmval,
    offset: uint32,
    size: uint32
): gmval;

/// Answers a write request. Call it for every write request, including one whose
/// response_needed was false: nothing is sent then, and the request is released.
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_server_respond_write(
    request_id: int32,
    [type_hint=`BluetoothAttError`] error_code: gmval
): gmval;

/// Copies the bytes a remote central wrote in a pending write request into out_data.
[global, bind = typed_gml]
function bluetooth_le_server_write_request_get_value(
    request_id: int32,
    [type_hint=buffer] out_data: gmval,
    offset: uint32,
    max_size: uint32
): int32;

/// Pushes an updated value to subscribed centrals. connection=0 broadcasts to all
/// subscribers; a server connection handle sends to that central only, and is
/// NotFound when it is not subscribed to the characteristic.
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_server_notify_value(
    service_uuid: string,
    characteristic_uuid: string,
    [type_hint=`uint64`] connection: gmval,
    [type_hint=buffer] data: gmval,
    offset: uint32,
    size: uint32
): gmval;

// =============================================================================
// Callbacks
// =============================================================================

/// callback(state) where state is BluetoothState. Fired whenever the local
/// Bluetooth adapter/manager changes state. Implementations should also deliver
/// the current known state after callback registration.
[global, bind = typed_gml]
function bluetooth_set_callback_state_changed(callback: func): bool;

[global, bind = typed_gml]
function bluetooth_remove_callback_state_changed(): bool;

/// callback(device)
/// Used by both BLE and Classic discovery. Inspect bluetooth_device_get_transport().
[global, bind = typed_gml]
function bluetooth_set_callback_device_found(callback: func): bool;

[global, bind = typed_gml]
function bluetooth_remove_callback_device_found(): bool;

/// callback(error_code, message, transport), transport a BluetoothTransport.
/// Fired when an LE or a Classic scan stops, whether it was stopped or failed.
[global, bind = typed_gml]
function bluetooth_set_callback_scan_stopped(callback: func): bool;

[global, bind = typed_gml]
function bluetooth_remove_callback_scan_stopped(): bool;

/// callback(connection, device)
/// Fired for an inbound RFCOMM server connection.
[global, bind = typed_gml]
function bluetooth_set_callback_classic_client_connected(callback: func): bool;

[global, bind = typed_gml]
function bluetooth_remove_callback_classic_client_connected(): bool;

/// callback(connection, available_bytes)
/// Bytes remain in a native queue until bluetooth_classic_receive() copies them.
/// Fired once when bytes arrive and again only after bluetooth_classic_receive()
/// has been called, so read with bluetooth_classic_receive_available(). On Windows
/// the connection stops reading from the peer while 1 MiB is waiting.
[global, bind = typed_gml]
function bluetooth_set_callback_classic_data(callback: func): bool;

[global, bind = typed_gml]
function bluetooth_remove_callback_classic_data(): bool;

/// callback(error_code, message, connection)
[global, bind = typed_gml]
function bluetooth_set_callback_classic_disconnected(callback: func): bool;

[global, bind = typed_gml]
function bluetooth_remove_callback_classic_disconnected(): bool;

/// callback(error_code, message, connection)
/// Fired when an established LE GATT connection drops asynchronously.
[global, bind = typed_gml]
function bluetooth_set_callback_le_disconnected(callback: func): bool;

[global, bind = typed_gml]
function bluetooth_remove_callback_le_disconnected(): bool;

/// callback(characteristic, connection, value, size)
/// Fired for every notify/indicate value update. value is a value handle holding
/// the bytes; copy them with bluetooth_le_value_copy().
[global, bind = typed_gml]
function bluetooth_set_callback_le_characteristic_value_changed(callback: func): bool;

[global, bind = typed_gml]
function bluetooth_remove_callback_le_characteristic_value_changed(): bool;

/// callback(connection, connected, device), connected a bool.
/// Fired when a remote central connects to or disconnects from our GATT server.
/// connection is the server connection handle the read and write requests carry,
/// and is retired on the disconnect. Windows reports a central on its first
/// request or subscription and its session closing; Apple, which has no
/// peripheral-side connection event, on its first request or subscription and
/// when its last subscription ends.
[global, bind = typed_gml]
function bluetooth_set_callback_le_server_connection_state_changed(callback: func): bool;

[global, bind = typed_gml]
function bluetooth_remove_callback_le_server_connection_state_changed(): bool;

/// callback(request_id, connection, service_uuid, characteristic_uuid, descriptor_uuid, offset)
/// descriptor_uuid is an empty string for a characteristic-level read request.
/// Respond with bluetooth_le_server_respond_read().
[global, bind = typed_gml]
function bluetooth_set_callback_le_server_read_request(callback: func): bool;

[global, bind = typed_gml]
function bluetooth_remove_callback_le_server_read_request(): bool;

/// callback(request_id, connection, service_uuid, characteristic_uuid, descriptor_uuid,
///          offset, response_needed)
/// descriptor_uuid is an empty string for a characteristic-level write request.
/// offset is where the bytes go in the attribute's value; a long write split by the
/// central arrives assembled, at the offset of its first part. response_needed is
/// false for a write without response; Apple does not say, and reports true.
/// Use bluetooth_le_server_write_request_get_value() to read the written bytes,
/// then respond with bluetooth_le_server_respond_write().
[global, bind = typed_gml]
function bluetooth_set_callback_le_server_write_request(callback: func): bool;

[global, bind = typed_gml]
function bluetooth_remove_callback_le_server_write_request(): bool;
