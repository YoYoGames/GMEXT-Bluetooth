function bluetooth_classic_discoverable_stop(): gmval;

[global, bind = typed_gml]
function bluetooth_classic_discoverable_is_running(): bool;

// =====================================================================
// Bluetooth pairing (bonding)
// =====================================================================

/// Whether this extension can explicitly initiate OS-level pairing for the
/// supplied device. This is device/transport-specific rather than a single
/// platform capability. Apple BLE pairing is implicit and therefore reports false.
[global, bind = typed_gml]
function bluetooth_pairing_is_supported([type_hint=`uint64`] device: gmval): bool;

/// Pairs (bonds) with the device at the OS level, separately from bluetooth_classic_connect
/// and bluetooth_le_connect; the OS remembers the pairing across runs.
/// callback(error_code, message, device) fires once, later: Ok when paired (at once on
/// Windows and Android for a device already paired); OperationFailed when the pairing
/// failed, was rejected or was cancelled; on macOS, Timeout after 60 seconds;
/// NotInitialized when bluetooth_shutdown comes first. Returns NotInitialized;
/// InvalidHandle for a handle that names no device; PermissionDenied, NotSupported or
/// BluetoothDisabled from the radio check; Busy while the same device is already
/// pairing; and the platform's own pre-flight codes below. The callback is not called
/// unless the return is Ok.
/// Android: Classic and LE, via BluetoothDevice.createBond(). InvalidArgument for a device
///   with no usable address; OperationFailed when the bond receiver cannot be registered
///   or createBond() fails.
/// Windows: Classic only, via BluetoothAuthenticateDeviceEx. NotSupported for LE;
///   InvalidArgument for a missing or malformed address; OperationFailed when the pairing
///   thread cannot start.
/// macOS: Classic only, via IOBluetoothDevicePair. PermissionDenied until
///   bluetooth_permission_request has been called; NotSupported for LE, since BLE bonding
///   on Apple happens implicitly when a protected characteristic is accessed;
///   InvalidArgument with no address; NotFound when IOBluetooth cannot resolve the device;
///   OperationFailed when the pairing cannot be created or started.
/// iOS: NotSupported after the checks above (Classic is not supported, BLE bonding is
///   implicit).
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_pair([type_hint=`uint64`] device: gmval, callback: func): gmval;

/// Whether the given device is currently paired/bonded at the OS level.
/// Android: BluetoothDevice.getBondState() == BOND_BONDED. Works for Classic and LE.
/// Windows: BluetoothGetDeviceInfo's fAuthenticated flag. Classic only; always false for LE.
/// macOS: IOBluetoothDevice.isPaired. Classic only; always false for LE, since Apple exposes
///   no public bond-state query for CoreBluetooth peripherals.
/// iOS: always false.
[global, bind = typed_gml]
function bluetooth_device_is_paired([type_hint=`uint64`] device: gmval): bool;

