    callback: func
): gmval;

// =============================================================================
// BLE values
// =============================================================================

/// Copies a value delivered by a read or a notification callback into out_data at
/// offset - all size bytes the callback reported - frees the value, and returns how
/// many bytes it copied. -1 on error, with the reason in bluetooth_last_error_code()
/// / bluetooth_last_error_message(): InvalidHandle for an unknown or already copied
/// value, InvalidArgument for a buffer too small for it, which keeps the value. The
/// bytes are written straight into the buffer's memory, so its used size does not
/// change: use the returned count, and buffer_set_used_size() before buffer_copy()
/// or buffer_save(). At most 256 values are held; past that the oldest is dropped,
/// and shutdown frees them all.
[global, bind = typed_gml]
function bluetooth_le_value_copy(
    [type_hint=`uint64`] value: gmval,
    [type_hint=buffer] out_data: gmval,
    offset: uint32
): int32;

/// Frees a value without copying it.
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_value_release(
    [type_hint=`uint64`] value: gmval
): gmval;

// =============================================================================
// BLE advertise
// =============================================================================

/// Starts advertising. A field the platform cannot send is NotSupported before
/// anything starts: Apple sends only the name and the service UUIDs and is always
/// connectable; Windows sends a service UUID, its service data and the name only
/// through a registered GATT service (the LeAdvertise* features). Busy while an
/// advertisement is starting or running: stop it first. Stopping it before it has
/// started fails the start with OperationFailed.
/// callback(error_code, message)
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_advertise_start(
    [type_hint=`BluetoothLeAdvertiseSettings`] settings: gmval,
    [type_hint=`BluetoothLeAdvertiseData`] data: gmval,
    callback: func
): gmval;

[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_advertise_stop(): gmval;

[global, bind = typed_gml]
function bluetooth_le_advertise_is_running(): bool;

// =============================================================================
// BLE GATT server (peripheral)
// =============================================================================

[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_server_start(): gmval;

/// Stops the server and removes its services; the server connection callback fires
