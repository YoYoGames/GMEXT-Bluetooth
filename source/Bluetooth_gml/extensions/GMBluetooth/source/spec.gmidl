    offset: uint32,
    size: uint32
): gmval;

// =============================================================================
// Callbacks
// =============================================================================

/// callback(state) where state is BluetoothState. Fired whenever the local
/// Bluetooth adapter/manager changes state, and once with the current state when it
/// is registered (Unknown before bluetooth_initialize).
[global, bind = typed_gml]
function bluetooth_set_callback_state_changed(callback: func): bool;

[global, bind = typed_gml]
function bluetooth_remove_callback_state_changed(): bool;

/// callback(device)
/// Used by both BLE and Classic discovery. Inspect bluetooth_device_get_transport().
/// Fired once per new device since the last bluetooth_device_clear(); later
/// advertisements update its name and RSSI, which the getters return. A central that
/// connects to the GATT server enters the cache without firing it.
[global, bind = typed_gml]
function bluetooth_set_callback_device_found(callback: func): bool;

[global, bind = typed_gml]
function bluetooth_remove_callback_device_found(): bool;

/// callback(error_code, message, transport), transport a BluetoothTransport.
/// Fired when an LE or a Classic scan stops, whether it was stopped or failed.
[global, bind = typed_gml]
function bluetooth_set_callback_scan_stopped(callback: func): bool;

[global, bind = typed_gml]
function bluetooth_remove_callback_scan_stopped(): bool;

/// callback(connection, device)
/// Fired for an inbound RFCOMM server connection.
[global, bind = typed_gml]
function bluetooth_set_callback_classic_client_connected(callback: func): bool;

[global, bind = typed_gml]
function bluetooth_remove_callback_classic_client_connected(): bool;

/// callback(connection, available_bytes)
/// Bytes remain in a native queue until bluetooth_classic_receive() copies them.
/// Fired once when bytes arrive and again only after bluetooth_classic_receive()
/// has been called, so read with bluetooth_classic_receive_available(). On Windows
/// and Android the connection stops reading from the peer while 1 MiB is waiting;
/// macOS cannot pause a channel, so it closes the connection with Disconnected
/// ("receive buffer full") when 1 MiB is waiting.
[global, bind = typed_gml]
function bluetooth_set_callback_classic_data(callback: func): bool;

[global, bind = typed_gml]
function bluetooth_remove_callback_classic_data(): bool;

/// callback(error_code, message, connection)
/// Fired when an established RFCOMM connection ends without bluetooth_classic_disconnect:
/// the peer closed it or the link failed (Disconnected, or the error that ended it).
[global, bind = typed_gml]
function bluetooth_set_callback_classic_disconnected(callback: func): bool;

[global, bind = typed_gml]
function bluetooth_remove_callback_classic_disconnected(): bool;

/// callback(error_code, message, connection)
/// Fired when an established LE GATT connection ends without bluetooth_le_disconnect:
/// the peer dropped it or the link failed. A disconnect the game asked for fires
/// nothing.
[global, bind = typed_gml]
function bluetooth_set_callback_le_disconnected(callback: func): bool;

[global, bind = typed_gml]
function bluetooth_remove_callback_le_disconnected(): bool;

/// callback(characteristic, connection, value, size)
/// Fired for every notify/indicate value update. value is a value handle holding
/// the bytes; copy them with bluetooth_le_value_copy().
[global, bind = typed_gml]
function bluetooth_set_callback_le_characteristic_value_changed(callback: func): bool;

[global, bind = typed_gml]
function bluetooth_remove_callback_le_characteristic_value_changed(): bool;

/// callback(connection, connected, device), connected a bool.
/// Fired when a remote central connects to or disconnects from our GATT server.
/// connection is the server connection handle the read and write requests carry,
/// and is retired on the disconnect. Windows reports a central on its first
/// request or subscription and its session closing; Apple, which has no
/// peripheral-side connection event, on its first request or subscription and
/// when its last subscription ends.
[global, bind = typed_gml]
function bluetooth_set_callback_le_server_connection_state_changed(callback: func): bool;

[global, bind = typed_gml]
function bluetooth_remove_callback_le_server_connection_state_changed(): bool;

/// callback(request_id, connection, service_uuid, characteristic_uuid, descriptor_uuid, offset)
/// descriptor_uuid is an empty string for a characteristic-level read request.
/// Respond with bluetooth_le_server_respond_read().
[global, bind = typed_gml]
function bluetooth_set_callback_le_server_read_request(callback: func): bool;

[global, bind = typed_gml]
function bluetooth_remove_callback_le_server_read_request(): bool;

/// callback(request_id, connection, service_uuid, characteristic_uuid, descriptor_uuid,
///          offset, response_needed)
/// descriptor_uuid is an empty string for a characteristic-level write request.
/// offset is where the bytes go in the attribute's value; a long write split by the
/// central arrives assembled, at the offset of its first part. response_needed is
/// false for a write without response; Apple does not say, and reports true.
/// Use bluetooth_le_server_write_request_get_value() to read the written bytes,
/// then respond with bluetooth_le_server_respond_write().
[global, bind = typed_gml]
function bluetooth_set_callback_le_server_write_request(callback: func): bool;

[global, bind = typed_gml]
function bluetooth_remove_callback_le_server_write_request(): bool;
