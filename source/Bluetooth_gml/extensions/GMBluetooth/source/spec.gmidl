[gml_api]
module GMBluetooth;

// =============================================================================
// Constants
// =============================================================================

[global, bind = typed_gml]
enum BluetoothError : int32 {
    Ok                = 0,
    Unknown           = 1,
    NotSupported      = 2,
    NotInitialized    = 3,
    BluetoothDisabled = 4,
    PermissionDenied  = 5,
    InvalidArgument   = 6,
    InvalidHandle     = 7,
    Busy              = 8,
    Timeout           = 9,
    NotFound          = 10,
    ConnectionFailed  = 11,
    Disconnected      = 12,
    OperationFailed   = 13
}

[global, bind = typed_gml]
enum BluetoothTransport : int32 {
    Unknown   = 0,
    Classic   = 1,
    LowEnergy = 2
}

[global, bind = typed_gml]
enum BluetoothPermissionStatus : int32 {
    Unknown = 0,
    Granted = 1,
    Denied  = 2
}

// =============================================================================
// Lifecycle / event pump
// =============================================================================

[global, bind = typed_gml]
function bluetooth_initialize(): bool;

[global, bind = typed_gml]
function bluetooth_shutdown(): unit;

/// Dispatches queued native Bluetooth events to registered GML callbacks.
/// Call this once per Step.
[global, bind = typed_gml]
function bluetooth_update(): int32;

[global, bind = typed_gml]
function bluetooth_is_initialized(): bool;

// =============================================================================
// Error state
// =============================================================================

[global, bind = typed_gml]
function bluetooth_last_error_code(): int32;

[global, bind = typed_gml]
function bluetooth_last_error_message(): string;

// =============================================================================
// Capabilities / permissions
// =============================================================================

[global, bind = typed_gml]
function bluetooth_le_is_supported(): bool;

[global, bind = typed_gml]
function bluetooth_classic_is_supported(): bool;

[global, bind = typed_gml]
function bluetooth_classic_server_is_supported(): bool;

/// Windows returns Granted. Android checks the runtime Bluetooth/location
/// permission set required by the current Android version.
[global, bind = typed_gml]
function bluetooth_permission_get_status(): int32;

/// Android: starts the system permission request when needed.
/// Windows: returns Ok immediately.
[global, bind = typed_gml]
function bluetooth_permission_request(): int32;

// =============================================================================
// BLE discovery
// =============================================================================

/// active=true requests scan-response packets where the platform supports it.
[global, bind = typed_gml]
function bluetooth_le_scan_start(active: bool): int32;

[global, bind = typed_gml]
function bluetooth_le_scan_stop(): int32;

[global, bind = typed_gml]
function bluetooth_le_scan_is_running(): bool;

// =============================================================================
// Bluetooth Classic discovery
// =============================================================================

[global, bind = typed_gml]
function bluetooth_classic_scan_start(): int32;

[global, bind = typed_gml]
function bluetooth_classic_scan_stop(): int32;

[global, bind = typed_gml]
function bluetooth_classic_scan_is_running(): bool;

// =============================================================================
// Shared discovered-device cache
// =============================================================================

[global, bind = typed_gml]
function bluetooth_device_clear(): unit;

[global, bind = typed_gml]
function bluetooth_device_get_count(): int32;

[global, bind = typed_gml, type_hint=`uint64`]
function bluetooth_device_get_at(index: int32): gmval;

[global, bind = typed_gml]
function bluetooth_device_is_valid([type_hint=`uint64`] device: gmval): bool;

[global, bind = typed_gml]
function bluetooth_device_get_transport([type_hint=`uint64`] device: gmval): int32;

/// Opaque platform identifier. Do not assume this is a MAC address.
[global, bind = typed_gml]
function bluetooth_device_get_id([type_hint=`uint64`] device: gmval): string;

[global, bind = typed_gml]
function bluetooth_device_get_name([type_hint=`uint64`] device: gmval): string;

[global, bind = typed_gml]
function bluetooth_device_has_address([type_hint=`uint64`] device: gmval): bool;

[global, bind = typed_gml]
function bluetooth_device_get_address([type_hint=`uint64`] device: gmval): string;

[global, bind = typed_gml]
function bluetooth_device_has_rssi([type_hint=`uint64`] device: gmval): bool;

[global, bind = typed_gml]
function bluetooth_device_get_rssi([type_hint=`uint64`] device: gmval): int32;

[global, bind = typed_gml]
function bluetooth_device_is_connectable([type_hint=`uint64`] device: gmval): bool;

// =============================================================================
// Bluetooth Classic RFCOMM client
// =============================================================================

/// Starts an asynchronous RFCOMM connection.
/// Returns a connection handle immediately, or 0 if the request cannot start.
/// callback(error_code, message, connection, device)
[global, bind = typed_gml, type_hint=`uint64`]
function bluetooth_classic_connect(
    [type_hint=`uint64`] device: gmval,
    service_uuid: string,
    callback: func
): gmval;

[global, bind = typed_gml]
function bluetooth_classic_disconnect(
    [type_hint=`uint64`] connection: gmval
): int32;

[global, bind = typed_gml]
function bluetooth_classic_connection_is_valid(
    [type_hint=`uint64`] connection: gmval
): bool;

[global, bind = typed_gml]
function bluetooth_classic_connection_is_connected(
    [type_hint=`uint64`] connection: gmval
): bool;

[global, bind = typed_gml, type_hint=`uint64`]
function bluetooth_classic_connection_get_device(
    [type_hint=`uint64`] connection: gmval
): gmval;

/// Number of native bytes waiting to be copied into GML.
[global, bind = typed_gml]
function bluetooth_classic_receive_available(
    [type_hint=`uint64`] connection: gmval
): int32;

/// TODO: final GMBuffer bridge intentionally left unimplemented until the
/// project-specific buffer convention is supplied.
[global, bind = typed_gml]
function bluetooth_classic_send(
    [type_hint=`uint64`] connection: gmval,
    [type_hint=buffer] data: gmval,
    offset: uint32,
    size: uint32
): int32;

/// TODO: final GMBuffer bridge intentionally left unimplemented until the
/// project-specific buffer convention is supplied.
[global, bind = typed_gml]
function bluetooth_classic_receive(
    [type_hint=`uint64`] connection: gmval,
    [type_hint=buffer] out_data: gmval,
    offset: uint32,
    max_size: uint32
): int32;

// =============================================================================
// Bluetooth Classic RFCOMM server
// =============================================================================

/// Starts an RFCOMM service using the supplied UUID.
[global, bind = typed_gml]
function bluetooth_classic_server_start(
    name: string,
    service_uuid: string
): int32;

[global, bind = typed_gml]
function bluetooth_classic_server_stop(): int32;

[global, bind = typed_gml]
function bluetooth_classic_server_is_running(): bool;

// =============================================================================
// Callbacks
// =============================================================================

/// callback(device)
/// Used by both BLE and Classic discovery. Inspect bluetooth_device_get_transport().
[global, bind = typed_gml]
function bluetooth_set_callback_device_found(callback: func): bool;

[global, bind = typed_gml]
function bluetooth_remove_callback_device_found(): bool;

/// callback(error_code, message)
/// Used by both scan types; preserved from the first BLE milestone.
[global, bind = typed_gml]
function bluetooth_set_callback_scan_stopped(callback: func): bool;

[global, bind = typed_gml]
function bluetooth_remove_callback_scan_stopped(): bool;

/// callback(connection, device)
/// Fired for an inbound RFCOMM server connection.
[global, bind = typed_gml]
function bluetooth_set_callback_classic_client_connected(callback: func): bool;

[global, bind = typed_gml]
function bluetooth_remove_callback_classic_client_connected(): bool;

/// callback(connection, available_bytes)
/// Bytes remain in a native queue until bluetooth_classic_receive() copies them.
[global, bind = typed_gml]
function bluetooth_set_callback_classic_data(callback: func): bool;

[global, bind = typed_gml]
function bluetooth_remove_callback_classic_data(): bool;

/// callback(connection, error_code, message)
[global, bind = typed_gml]
function bluetooth_set_callback_classic_disconnected(callback: func): bool;

[global, bind = typed_gml]
function bluetooth_remove_callback_classic_disconnected(): bool;
