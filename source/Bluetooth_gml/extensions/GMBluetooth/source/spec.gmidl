[gml_api]
module GMBluetooth;

// Conventions
//
// Every call that can fail returns a BluetoothError, except bluetooth_classic_connect
// and bluetooth_le_connect, which return the new connection handle so that
// bluetooth_*_disconnect can cancel a connect still in progress; they return 0 when
// the connect did not start. After any failed return, bluetooth_last_error_code()
// and bluetooth_last_error_message() say why. A call that fails before it starts
// never fires its callback.
//
// A callback that reports an outcome that can fail leads with (error_code, message),
// followed by its data. An event that cannot fail carries data only, its subject first.
//
// The same condition fails with the same code on every platform:
//   a handle that is not (or no longer) valid       InvalidHandle
//   a device of the wrong transport, a bad argument InvalidArgument
//   the radio is off                                BluetoothDisabled
//   the permission is missing or was refused        PermissionDenied
//   no Bluetooth hardware, or a feature the platform
//   cannot do (see bluetooth_feature_is_supported)  NotSupported
//   the LE server is not running                    OperationFailed
//   a second advertise, a duplicate service, a full
//   send or notify queue                            Busy
// These are checked before anything starts, so they come back from the call itself.
// A start while already running (scan, server) is Ok and starts nothing new; a stop
// while idle is Ok and fires nothing. A disconnect the game asks for is synchronous:
// the handle is retired by the call and no disconnected callback fires for it.

// =============================================================================
// Constants
// =============================================================================

/// NotPermitted: the remote device refused the attribute operation (ATT read/write
/// not permitted, request not supported). InsufficientSecurity: it needs pairing,
/// encryption or authorization first (ATT insufficient authentication, authorization,
/// encryption or key size). The message names the ATT code.
[global, bind = typed_gml]
enum BluetoothError : int32 {
    Ok                   = 0,
    Unknown              = 1,
    NotSupported         = 2,
    NotInitialized       = 3,
    BluetoothDisabled    = 4,
    PermissionDenied     = 5,
    InvalidArgument      = 6,
    InvalidHandle        = 7,
    Busy                 = 8,
    Timeout              = 9,
    NotFound             = 10,
    ConnectionFailed     = 11,
    Disconnected         = 12,
    OperationFailed      = 13,
    NotPermitted         = 14,
    InsufficientSecurity = 15
}

/// ATT error codes (Bluetooth Core Specification, Vol 3, Part F, 3.4.1.1), used to
/// answer a GATT server read or write request.
[global, bind = typed_gml]
enum BluetoothAttError : int32 {
    Success                       = 0,
    InvalidHandle                 = 1,
    ReadNotPermitted              = 2,
    WriteNotPermitted             = 3,
    InvalidPdu                    = 4,
    InsufficientAuthentication    = 5,
    RequestNotSupported           = 6,
    InvalidOffset                 = 7,
    InsufficientAuthorization     = 8,
    PrepareQueueFull              = 9,
    AttributeNotFound             = 10,
    AttributeNotLong              = 11,
    InsufficientEncryptionKeySize = 12,
    InvalidAttributeValueLength   = 13,
    UnlikelyError                 = 14,
    InsufficientEncryption        = 15,
    UnsupportedGroupType          = 16,
    InsufficientResources         = 17
}

[global, bind = typed_gml]
enum BluetoothTransport : int32 {
    Unknown   = 0,
    Classic   = 1,
    LowEnergy = 2
}

[global, bind = typed_gml]
enum BluetoothPermissionStatus : int32 {
    Unknown = 0,
    Granted = 1,
    Denied  = 2
}

[global, bind = typed_gml]
enum BluetoothLeSubscribeMode : int32 {
    Unsubscribe = 0,
    Notify      = 1,
    Indicate    = 2
}

/// Cross-platform GATT characteristic-property bitmask, the GATT core properties
/// byte that Android, Apple and Windows share. Platform bits above 0x80 are masked
/// off what bluetooth_le_characteristic_get_properties() returns, and a server
/// characteristic definition that sets one is InvalidArgument.
[global, bind = typed_gml]
enum BluetoothLeCharacteristicProperty : int32 {
    None                      = 0,
    Broadcast                 = 1,
    Read                      = 2,
    WriteWithoutResponse      = 4,
    Write                     = 8,
    Notify                    = 16,
    Indicate                  = 32,
    AuthenticatedSignedWrites = 64,
    ExtendedProperties        = 128
}

/// GATT server attribute permission flags, combined with |. The values are Android's
/// BluetoothGattCharacteristic.PERMISSION_* bits. Apple and Windows have no signed
/// write permission: WriteSigned and WriteSignedMitm are NotSupported there.
[global, bind = typed_gml]
enum BluetoothLeAttributePermission : int32 {
    None               = 0,
    Read               = 1,
    ReadEncrypted      = 2,
    ReadEncryptedMitm  = 4,
    Write              = 16,
    WriteEncrypted     = 32,
    WriteEncryptedMitm = 64,
    WriteSigned        = 128,
    WriteSignedMitm    = 256
}

[global, bind = typed_gml]
enum BluetoothLeWriteType : int32 {
    WithResponse    = 0,
    WithoutResponse = 1
}

/// Advertising transmit power. The members are Android's AdvertiseSettings
/// levels; Windows maps them to -21, -15, -7 and 1 dBm.
[global, bind = typed_gml]
enum BluetoothLeAdvertiseTxPower : int32 {
    UltraLow = 0,
    Low      = 1,
    Medium   = 2,
    High     = 3
}

/// How fast a client LE connection runs, traded against power. The members are
/// Android's BluetoothGatt.CONNECTION_PRIORITY_* values; Windows 11 maps them to
/// ThroughputOptimized, Balanced and PowerOptimized.
[global, bind = typed_gml]
enum BluetoothLeConnectionPriority : int32 {
    Balanced = 0,
    High     = 1,
    LowPower = 2
}

/// Normalized local Bluetooth adapter/manager state.
[global, bind = typed_gml]
enum BluetoothState : int32 {
    Unknown      = 0,
    Resetting    = 1,
    Unsupported  = 2,
    Unauthorized = 3,
    PoweredOff   = 4,
    PoweredOn    = 5
}

/// What bluetooth_feature_is_supported() can be asked. LeCentral, LeAdvertise,
/// LeServer, Classic and ClassicServer answer as the matching *_is_supported
/// function. LePassiveScan: bluetooth_le_scan_start(false) really scans passively;
/// elsewhere the argument is ignored. LeAdvertise*: the advertisement can carry that
/// part of BluetoothLeAdvertiseData or BluetoothLeAdvertiseSettings; one that cannot
/// is NotSupported from bluetooth_le_advertise_start. LeServerDescriptorRequests:
/// reads and writes of a server descriptor reach the request callbacks.
/// LeServerSignedWrite: the WriteSigned permissions. LeServerConnectionEvents: the
/// server connection callback reports a central's connect and disconnect as they
/// happen, not only around its requests and subscriptions. LePairing and
/// ClassicPairing: bluetooth_pair works for that transport. ClassicDiscoverableStop:
/// bluetooth_classic_discoverable_stop can end discoverability early.
/// PermissionRequest: bluetooth_permission_request shows a system prompt.
/// LeMtuRequest: bluetooth_le_connection_request_mtu negotiates the MTU asked for;
/// elsewhere the platform negotiates it itself and the request reports that value.
/// LeReadRssi: bluetooth_le_connection_read_rssi. LeConnectionPriority:
/// bluetooth_le_connection_request_priority. RequestEnable: bluetooth_request_enable
/// can turn the radio on. PairedDevicesQuery: bluetooth_paired_devices_query.
[global, bind = typed_gml]
enum BluetoothFeature : int32 {
    LeCentral                   = 0,
    LePassiveScan               = 1,
    LeAdvertise                 = 2,
    LeAdvertiseName             = 3,
    LeAdvertiseServiceUuids     = 4,
    LeAdvertiseServiceData      = 5,
    LeAdvertiseManufacturerData = 6,
    LeAdvertiseTxPower          = 7,
    LeAdvertiseIncludeTxPower   = 8,
    LeAdvertiseNonConnectable   = 9,
    LeServer                    = 10,
    LeServerDescriptorRequests  = 11,
    LeServerSignedWrite         = 12,
    LeServerConnectionEvents    = 13,
    LePairing                   = 14,
    Classic                     = 15,
    ClassicServer               = 16,
    ClassicPairing              = 17,
    ClassicDiscoverable         = 18,
    ClassicDiscoverableStop     = 19,
    PermissionRequest           = 20,
    LeMtuRequest                = 21,
    LeReadRssi                  = 22,
    LeConnectionPriority        = 23,
    RequestEnable               = 24,
    PairedDevicesQuery          = 25
}

// =============================================================================
// BLE GATT server definitions
// =============================================================================

/// Descriptor definition used by BluetoothLeCharacteristicDefinition. The Client
/// Characteristic Configuration descriptor (0x2902) is managed by the platform and
/// skipped. Apple can publish only a User Description (0x2901), which it serves
/// empty; any other descriptor is NotSupported there (LeServerDescriptorRequests).
[global]
class `[[BluetoothLeDescriptorDefinition]]` prototype Object {
    [field]
    property uuid : string { get; set; }
}

/// Characteristic definition used by BluetoothLeServiceDefinition.
/// properties is a combination of BluetoothLeCharacteristicProperty flags.
/// permissions is a combination of BluetoothLeAttributePermission flags.
/// value is the initial value, at most 512 bytes; an empty array means none.
[global]
class `[[BluetoothLeCharacteristicDefinition]]` prototype Object {
    [field]
    property uuid : string { get; set; }

    [field]
    property properties : int32 { get; set; }

    [field]
    property permissions : int32 { get; set; }

    [field, type_hint=`uint8[]`]
    property value : gmval { get; set; }

    [field, type_hint=`BluetoothLeDescriptorDefinition[]`]
    property descriptors : gmval { get; set; }
}

/// Complete primary local GATT service definition.
[global]
class `[[BluetoothLeServiceDefinition]]` prototype Object {
    [field]
    property uuid : string { get; set; }

    [field, type_hint=`BluetoothLeCharacteristicDefinition[]`]
    property characteristics : gmval { get; set; }
}

// =============================================================================
// BLE advertising definitions
// =============================================================================

/// How the advertisement is sent. tx_power left undefined is the platform default.
[global]
class `[[BluetoothLeAdvertiseSettings]]` prototype Object {
    [field]
    property connectable : bool { get; set; }

    [field, type_hint=`BluetoothLeAdvertiseTxPower?`]
    property tx_power : gmval { get; set; }
}

/// Service data for one service. Its uuid must also be in service_uuids.
[global]
class `[[BluetoothLeAdvertiseServiceData]]` prototype Object {
    [field]
    property uuid : string { get; set; }

    [field, type_hint=`uint8[]`]
    property data : gmval { get; set; }
}

/// Manufacturer-specific data under a Bluetooth SIG company identifier (0-65535).
[global]
class `[[BluetoothLeAdvertiseManufacturerData]]` prototype Object {
    [field]
    property company_id : int32 { get; set; }

    [field, type_hint=`uint8[]`]
    property data : gmval { get; set; }
}

/// What the advertisement carries.
[global]
class `[[BluetoothLeAdvertiseData]]` prototype Object {
    [field]
    property include_name : bool { get; set; }

    [field]
    property include_tx_power : bool { get; set; }

    [field, type_hint=`string[]`]
    property service_uuids : gmval { get; set; }

    [field, type_hint=`BluetoothLeAdvertiseServiceData[]`]
    property service_data : gmval { get; set; }

    [field, type_hint=`BluetoothLeAdvertiseManufacturerData[]`]
    property manufacturer_data : gmval { get; set; }
}

// =============================================================================
// BLE scanning definitions
// =============================================================================

/// What a device has advertised, merged over every advertisement and scan response
/// since it entered the cache: service_uuids collects every UUID seen, a service
/// data or manufacturer data entry is the latest for its uuid or company_id, and
/// tx_power is the latest advertised TX Power Level in dBm, undefined when none
/// was advertised. UUIDs are lowercase 128-bit.
[global]
class `[[BluetoothLeAdvertisement]]` prototype Object {
    [field, type_hint=`string[]`]
    property service_uuids : gmval { get; set; }

    [field, type_hint=`BluetoothLeAdvertiseServiceData[]`]
    property service_data : gmval { get; set; }

    [field, type_hint=`BluetoothLeAdvertiseManufacturerData[]`]
    property manufacturer_data : gmval { get; set; }

    [field, type_hint=`int32?`]
    property tx_power : gmval { get; set; }
}

/// One scan filter. A device matches when every field that is set matches its
/// merged advertisement: service_uuid is among its advertised service UUIDs, name
/// equals its advertised local name exactly, company_id (0-65535) has manufacturer
/// data. A filter must set at least one field.
[global]
class `[[BluetoothLeScanFilter]]` prototype Object {
    [field, type_hint=`string?`]
    property service_uuid : gmval { get; set; }

    [field, type_hint=`string?`]
    property name : gmval { get; set; }

    [field, type_hint=`int32?`]
    property company_id : gmval { get; set; }
}

// =============================================================================
// Lifecycle / event pump
// =============================================================================

/// True once the extension is loaded and running, also on a device with no
/// Bluetooth: that reports BluetoothState.Unsupported and false from the
/// *_is_supported functions, and every Bluetooth call is NotSupported.
[global, bind = typed_gml]
function bluetooth_initialize(): bool;

/// Ends every connection, scan, advertisement and server, and fails each pending
/// callback once with NotInitialized. The callbacks registered with
/// bluetooth_set_callback_* stay registered for the next bluetooth_initialize.
[global, bind = typed_gml]
function bluetooth_shutdown(): unit;


[global, bind = typed_gml]
function bluetooth_is_initialized(): bool;

// =============================================================================
// Error state
// =============================================================================

[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_last_error_code(): gmval;

[global, bind = typed_gml]
function bluetooth_last_error_message(): string;

// =============================================================================
// Capabilities / permissions
// =============================================================================

[global, bind = typed_gml]
function bluetooth_le_is_supported(): bool;

[global, bind = typed_gml]
function bluetooth_le_advertise_is_supported(): bool;

[global, bind = typed_gml]
function bluetooth_le_server_is_supported(): bool;

[global, bind = typed_gml]
function bluetooth_classic_is_supported(): bool;

[global, bind = typed_gml]
function bluetooth_classic_server_is_supported(): bool;

/// Whether this platform and adapter can do feature, a BluetoothFeature; false for a
/// value that is not one. Ask after bluetooth_initialize: on Windows the answers
/// come from the adapter.
[global, bind = typed_gml]
function bluetooth_feature_is_supported([type_hint=`BluetoothFeature`] feature: gmval): bool;

/// Windows returns Granted. Android checks the runtime Bluetooth/location
/// permission set required by the current Android version.
[global, bind = typed_gml, type_hint=`BluetoothPermissionStatus`]
function bluetooth_permission_get_status(): gmval;

/// Asks for the Bluetooth permissions the platform needs, showing the system prompt
/// when the answer is not known yet. callback(error_code, message, status), status a
/// BluetoothPermissionStatus, fires once: when the user answers, or at once when the
/// answer is already known (always Granted on Windows). On Apple the prompt appears
/// only here; until it has been answered, every call that uses Bluetooth returns
/// PermissionDenied, as on Android without the runtime permissions.
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_permission_request(callback: func): gmval;

/// Asks the user to turn the Bluetooth radio on (RequestEnable). callback(error_code,
/// message) fires once: Ok when the radio is on, at once when it already was;
/// BluetoothDisabled when the user declined or the radio stayed off; PermissionDenied
/// when the system refused the request. Android shows the system dialog and needs the
/// Bluetooth permission on Android 12+ (PermissionDenied before it starts). Windows
/// asks for radio access and switches the radio on. Apple has no API to do this:
/// NotSupported.
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_request_enable(callback: func): gmval;

// =============================================================================
// BLE discovery
// =============================================================================

/// active=true requests scan-response packets; active=false scans passively only
/// where LePassiveScan is supported (Windows) and is ignored elsewhere. filters is an
/// array of BluetoothLeScanFilter: empty reports every device, otherwise a device
/// enters the cache, firing device_found, once its advertisement matches any one of
/// them. A bad filter (no field set, a malformed UUID, a company_id outside 0-65535)
/// is InvalidArgument. Fails before it starts with BluetoothDisabled,
/// PermissionDenied or NotSupported; while the state is still Unknown the scan starts
/// once the radio is ready. A start while a scan runs is Ok and keeps the running
/// scan's filters: stop it first to change them. Android filters in the Bluetooth
/// stack, scans in low-latency mode and allows 5 scan starts per 30 seconds - a sixth
/// starts but finds nothing - and pauses unfiltered scans while the screen is off.
/// iOS needs every filter to set service_uuid to scan in the background.
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_scan_start(
    active: bool,
    [type_hint=`BluetoothLeScanFilter[]`] filters: gmval
): gmval;

[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_scan_stop(): gmval;

[global, bind = typed_gml]
function bluetooth_le_scan_is_running(): bool;

// =============================================================================
// Bluetooth Classic discovery
// =============================================================================

[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_classic_scan_start(): gmval;

[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_classic_scan_stop(): gmval;

[global, bind = typed_gml]
function bluetooth_classic_scan_is_running(): bool;

// =============================================================================
// Shared discovered-device cache
// =============================================================================

/// Empties the device cache; every device handle becomes invalid. The cache keeps
/// every device seen since the last clear (handles are never reused), so call this
/// during long scans in busy places.
[global, bind = typed_gml]
function bluetooth_device_clear(): unit;

[global, bind = typed_gml]
function bluetooth_device_get_count(): int32;

[global, bind = typed_gml, type_hint=`uint64`]
function bluetooth_device_get_at(index: int32): gmval;

[global, bind = typed_gml]
function bluetooth_device_is_valid([type_hint=`uint64`] device: gmval): bool;

[global, bind = typed_gml, type_hint=`BluetoothTransport`]
function bluetooth_device_get_transport([type_hint=`uint64`] device: gmval): gmval;

/// Opaque platform identifier. Do not assume this is a MAC address.
[global, bind = typed_gml]
function bluetooth_device_get_id([type_hint=`uint64`] device: gmval): string;

[global, bind = typed_gml]
function bluetooth_device_get_name([type_hint=`uint64`] device: gmval): string;

[global, bind = typed_gml]
function bluetooth_device_has_address([type_hint=`uint64`] device: gmval): bool;

[global, bind = typed_gml]
function bluetooth_device_get_address([type_hint=`uint64`] device: gmval): string;

[global, bind = typed_gml]
function bluetooth_device_has_rssi([type_hint=`uint64`] device: gmval): bool;

[global, bind = typed_gml]
function bluetooth_device_get_rssi([type_hint=`uint64`] device: gmval): int32;

[global, bind = typed_gml]
function bluetooth_device_is_connectable([type_hint=`uint64`] device: gmval): bool;

/// What the device has advertised (see BluetoothLeAdvertisement). Every field is
/// empty for a Classic device, one never seen advertising, or an invalid handle.
[global, bind = typed_gml, type_hint=`BluetoothLeAdvertisement`]
function bluetooth_device_get_advertisement([type_hint=`uint64`] device: gmval): gmval;

/// Returns the handle of the device an id from bluetooth_device_get_id names, so a
/// remembered device can be connected without scanning. A device already in the cache
/// keeps its handle; otherwise it enters the cache without firing device_found, and
/// its name is empty until the platform knows it. 0 when it cannot, the reason in
/// bluetooth_last_error_code(): InvalidArgument for an id from another platform or a
/// malformed one; on Apple, BluetoothDisabled while the radio is off and NotFound
/// for an LE id the system does not know.
[global, bind = typed_gml, type_hint=`uint64`]
function bluetooth_device_from_id(id: string): gmval;

/// Lists the LE devices connected to this system, by this or another app.
/// callback(error_code, message, devices), devices an array of device handles; a
/// device not yet in the cache enters it without firing device_found. Android and
/// Windows list every connected LE device and ignore service_uuids. Apple lists
/// only those exposing one of service_uuids, and an empty array is InvalidArgument
/// there.
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_connected_devices_query(
    [type_hint=`string[]`] service_uuids: gmval,
    callback: func
): gmval;

/// Lists the devices paired (bonded) with this system, without a scan
/// (PairedDevicesQuery). callback(error_code, message, devices), devices an array of
/// device handles; a device not yet in the cache enters it without firing
/// device_found. Android lists Classic and LE bonds (a dual-mode device as one entry
/// of each transport); Windows lists paired Classic and LE devices; macOS lists
/// paired Classic devices; iOS is NotSupported. Classic scans report only devices
/// that answered the inquiry, never the paired list.
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_paired_devices_query(callback: func): gmval;

// =============================================================================
// Bluetooth Classic RFCOMM client
// =============================================================================

/// Starts an asynchronous RFCOMM connection.
/// Returns a connection handle immediately, or 0 if the request cannot start, the
/// reason then in bluetooth_last_error_code(). bluetooth_classic_disconnect on the
/// handle cancels a connect still in progress, which then fires the callback once
/// with ConnectionFailed. A connect that has not completed after 15 seconds fails
/// with Timeout on Windows. The link is authenticated (secure RFCOMM), so an
/// unpaired peer may see a pairing prompt.
/// callback(error_code, message, connection, device)
[global, bind = typed_gml, type_hint=`uint64`]
function bluetooth_classic_connect(
    [type_hint=`uint64`] device: gmval,
    service_uuid: string,
    callback: func
): gmval;

[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_classic_disconnect(
    [type_hint=`uint64`] connection: gmval
): gmval;

[global, bind = typed_gml]
function bluetooth_classic_connection_is_valid(
    [type_hint=`uint64`] connection: gmval
): bool;

[global, bind = typed_gml]
function bluetooth_classic_connection_is_connected(
    [type_hint=`uint64`] connection: gmval
): bool;

[global, bind = typed_gml, type_hint=`uint64`]
function bluetooth_classic_connection_get_device(
    [type_hint=`uint64`] connection: gmval
): gmval;

/// Number of native bytes waiting to be copied into GML.
[global, bind = typed_gml]
function bluetooth_classic_receive_available(
    [type_hint=`uint64`] connection: gmval
): int32;

/// Queues bytes from a GameMaker buffer to be sent over the RFCOMM connection and
/// returns without waiting for them to go out. Busy when the bytes would take the
/// connection's queue past 1 MiB, so send more than that in parts.
/// A send that later fails ends the connection through the classic_disconnected
/// callback.
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_classic_send(
    [type_hint=`uint64`] connection: gmval,
    [type_hint=buffer] data: gmval,
    offset: uint32,
    size: uint32
): gmval;

/// Copies up to max_size available RFCOMM bytes into out_data at offset and returns
/// how many it copied (0 when none are waiting), or -1 on error with the reason in
/// bluetooth_last_error_code() / bluetooth_last_error_message(). The bytes are
/// written straight into the buffer's memory, so its used size does not change: use
/// the returned count, and buffer_set_used_size() before buffer_copy() or
/// buffer_save().
[global, bind = typed_gml]
function bluetooth_classic_receive(
    [type_hint=`uint64`] connection: gmval,
    [type_hint=buffer] out_data: gmval,
    offset: uint32,
    max_size: uint32
): int32;

// =============================================================================
// Bluetooth Classic RFCOMM server
// =============================================================================

/// Starts an RFCOMM service using the supplied UUID. Busy while a server is already
/// running: stop it first to change its name or UUID. Incoming links are
/// authenticated (secure RFCOMM).
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_classic_server_start(
    name: string,
    service_uuid: string
): gmval;

[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_classic_server_stop(): gmval;

[global, bind = typed_gml]
function bluetooth_classic_server_is_running(): bool;

// =============================================================================
// Bluetooth Classic discoverability
// =============================================================================

/// Makes the local radio discoverable to other devices' Classic inquiry scans, so
/// bluetooth_classic_server_start's service can actually be found by an unpaired peer.
/// duration_seconds: how long to stay discoverable. 0 = indefinite where the platform allows it.
/// Windows: fully supported, start/stop both work, duration enforced by this extension via a timer.
/// Android: asks the user to make the device discoverable for duration_seconds, clamped to
///   1-3600 (0 or less is the Android default of 120s; there is no "indefinite"). Ok means the
///   request was shown, not that the user accepted: poll bluetooth_classic_discoverable_is_running.
///   There is no OS API to cancel discoverability early, so bluetooth_classic_discoverable_stop
///   returns NotSupported on this platform and it simply expires on its own.
/// macOS/iOS: no public API exists; returns NotSupported.
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_classic_discoverable_start(duration_seconds: int32): gmval;

/// Stops discoverability early. See bluetooth_classic_discoverable_start for per-platform support
/// (NotSupported on Android and Apple).
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_classic_discoverable_stop(): gmval;

[global, bind = typed_gml]
function bluetooth_classic_discoverable_is_running(): bool;

// =====================================================================
// Bluetooth pairing (bonding)
// =====================================================================

/// Whether this extension can explicitly initiate OS-level pairing for the
/// supplied device. This is device/transport-specific rather than a single
/// platform capability. Apple BLE pairing is implicit and therefore reports false.
[global, bind = typed_gml]
function bluetooth_pairing_is_supported([type_hint=`uint64`] device: gmval): bool;

/// Attempts to pair (bond) with the given device at the OS level. This is separate from
/// bluetooth_classic_connect/bluetooth_le_connect: some connections only succeed once the
/// two devices are paired, and once paired the OS remembers the relationship across app runs.
/// Returns immediately with an error code indicating whether the pairing request was
/// accepted; callback is invoked once, later, when pairing actually completes or fails:
/// callback(error_code, message, device).
/// Android: works uniformly for Classic and LE devices, via BluetoothDevice.createBond().
/// Windows: Classic only, via BluetoothAuthenticateDeviceEx. Returns NotSupported for LE
///   devices.
/// macOS: Classic only, via IOBluetoothDevicePair. Returns NotSupported for LE devices -
///   BLE bonding on Apple platforms happens implicitly when a protected characteristic is
///   accessed and cannot be triggered explicitly.
/// iOS: always NotSupported (Classic isn't supported on iOS; BLE bonding is implicit, as above).
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_pair([type_hint=`uint64`] device: gmval, callback: func): gmval;

/// Whether the given device is currently paired/bonded at the OS level.
/// Android: BluetoothDevice.getBondState() == BOND_BONDED. Works for Classic and LE.
/// Windows: BluetoothGetDeviceInfo's fAuthenticated flag. Classic only; always false for LE.
/// macOS: IOBluetoothDevice.isPaired. Classic only; always false for LE, since Apple exposes
///   no public bond-state query for CoreBluetooth peripherals.
/// iOS: always false.
[global, bind = typed_gml]
function bluetooth_device_is_paired([type_hint=`uint64`] device: gmval): bool;

// =============================================================================
// BLE GATT client: connect / disconnect
// =============================================================================

/// Starts an asynchronous GATT connection to a previously discovered LE device.
/// Returns a connection handle immediately, or 0 if the request cannot start, the
/// reason then in bluetooth_last_error_code(). bluetooth_le_disconnect on the handle
/// cancels a connect still in progress, which then fires the callback once with
/// ConnectionFailed. Timeout: the device did not answer within 15 seconds;
/// ConnectionFailed: it refused, the link failed, or the connect was cancelled. Busy
/// while the device already has a connection.
/// callback(error_code, message, connection, device)
[global, bind = typed_gml, type_hint=`uint64`]
function bluetooth_le_connect(
    [type_hint=`uint64`] device: gmval,
    callback: func
): gmval;

/// Closes a client connection made by bluetooth_le_connect, or cancels it while it
/// is still connecting. A server connection is InvalidHandle: it ends when the
/// central disconnects.
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_disconnect(
    [type_hint=`uint64`] connection: gmval
): gmval;

[global, bind = typed_gml]
function bluetooth_le_connection_is_valid(
    [type_hint=`uint64`] connection: gmval
): bool;

[global, bind = typed_gml]
