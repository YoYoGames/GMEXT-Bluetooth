/// Requests still waiting are answered UnlikelyError and add_service calls still
/// waiting fail with OperationFailed.
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_server_clear_services(): gmval;

/// Answers a read request with Success and size bytes of data from offset.
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_server_respond_read(
    request_id: int32,
    [type_hint=buffer] data: gmval,
    offset: uint32,
    size: uint32
): gmval;

/// Refuses a read request with error_code, a BluetoothAttError other than Success
/// (InvalidArgument).
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_server_respond_read_error(
    request_id: int32,
    [type_hint=`BluetoothAttError`] error_code: gmval
): gmval;

/// Answers a write request. Call it for every write request, including one whose
/// response_needed was false: nothing is sent then, and the request is released.
/// The request's value is freed with it, so fetch the value first.
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_server_respond_write(
    request_id: int32,
    [type_hint=`BluetoothAttError`] error_code: gmval
): gmval;

/// Pushes an updated value of a server characteristic (a handle from the
/// add_service callback's service) to subscribed centrals. InvalidHandle for a
/// handle that is not a live server characteristic. connection=0 broadcasts to all
/// subscribers; a server connection handle sends to that central only, and is
/// NotFound when it is not subscribed to the characteristic. The value is queued and
/// sent as the link allows; Busy while 64 values wait to be sent.
[global, bind = typed_gml, type_hint=`BluetoothError`]
function bluetooth_le_server_notify_value(
    [type_hint=`uint64`] characteristic: gmval,
    [type_hint=`uint64`] connection: gmval,
    [type_hint=buffer] data: gmval,
    offset: uint32,
    size: uint32
): gmval;

// =============================================================================
// Callbacks
// =============================================================================

/// callback(state) where state is BluetoothState. Fired whenever the local
/// Bluetooth adapter/manager changes state, and once with the current state when it
/// is registered (Unknown before bluetooth_initialize). The one global callback: every
/// other event is passed to the call that starts its subject.
[global, bind = typed_gml]
function bluetooth_set_callback_state_changed(callback: func): bool;

[global, bind = typed_gml]
function bluetooth_remove_callback_state_changed(): bool;
